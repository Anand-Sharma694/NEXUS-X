@app.patch("/api/tasks/<int:tid>")
@auth_required
def update_task(tid):
    d=request.get_json(silent=True) or {}; allowed={"status","priority","owner","effort","due_date","name","description"}; fields={k:d[k] for k in allowed if k in d}
    if "status" in fields and fields["status"] not in STATUSES:return jsonify({"error":"Invalid status."}),400
    c=db(); t=c.execute("SELECT * FROM tasks WHERE id=?",(tid,)).fetchone()
    if not t:c.close();return jsonify({"error":"Task not found."}),404
    p=c.execute("SELECT owner_id FROM projects WHERE id=?",(t["project_id"],)).fetchone()
    if not p:c.close();return jsonify({"error":"Forbidden."}),403
    if any(k in fields for k in ("name","description","priority","owner","effort","due_date")) and not can_manage_project(t["project_id"]):
        c.close(); return jsonify({"error":"Manager or owner permission required for task planning changes."}),403
    if not fields:c.close();return jsonify(rowdict(t))
    if "effort" in fields: fields["effort"]=max(0.1,float(fields["effort"]))
    sets=", ".join(f"{k}=?" for k in fields); c.execute(f"UPDATE tasks SET {sets} WHERE id=?",(*fields.values(),tid)); c.commit(); pid=t["project_id"]; c.close()
    add_activity(pid,"Task updated",f"{t['task_key']} changed: {', '.join(fields)}"); refresh_notifications(pid); return jsonify(project_state(pid))

@app.post("/api/tasks")
@auth_required
def create_task():
    d=request.get_json(silent=True) or {}; pid=int(d.get("project_id") or 0); p=project_owned(pid)
    if not p:return jsonify({"error":"Project not found."}),404
    err=require_manager(pid)
    if err:return err
    name=(d.get("name") or "").strip();
    if not name:return jsonify({"error":"Task name required."}),400
    c=db(); key=f"T{c.execute('SELECT COUNT(*) AS count FROM tasks WHERE project_id=?',(pid,)).fetchone()['count']+1}"; tid=c.execute("INSERT INTO tasks(project_id,task_key,name,description,priority,effort,risk_level,status,owner,due_date) VALUES(?,?,?,?,?,?,?,?,?,?)",(pid,key,name,d.get("description",""),d.get("priority","MEDIUM"),max(0.1,float(d.get("effort",1))),d.get("risk_level","MEDIUM"),"NOT STARTED",d.get("owner","Unassigned"),d.get("due_date"))).lastrowid; c.commit();c.close();add_activity(pid,"Task created",name);refresh_notifications(pid);return jsonify(project_state(pid))

