@app.post("/api/team/invite")
@auth_required
def invite_team_member():
    d=request.get_json(silent=True) or {}; pid=int(d.get("project_id") or 0); err=require_manager(pid)
    if err:return err
    email=(d.get("email") or "").strip().lower(); role=(d.get("role") or "MEMBER").strip().upper()
    if not email:return jsonify({"error":"Email is required."}),400
    c=db(); u=c.execute("SELECT id,name,email,role,plan FROM users WHERE email=?",(email,)).fetchone()
    if not u:c.close();return jsonify({"error":"No NEXUS-X account exists for that email yet. Ask the person to create a Free account first."}),404
    try:
        c.execute("INSERT INTO project_members(project_id,user_id,role,created_at) VALUES(?,?,?,?)",(pid,u["id"],role,now()))
        # Keep a visible operational team member record linked to the user.
        c.execute("INSERT INTO team_members(project_id,name,role,skills,availability,workload,daily_rate,user_id) VALUES(?,?,?,?,?,?,?,?)",(pid,u["name"],role,"General",80,0,float(os.getenv("NEXUS_DEFAULT_DAILY_RATE","2000")),u["id"]))
        c.commit()
    except sqlite3.IntegrityError:
        c.close();return jsonify({"error":"That user is already a member of this project."}),409
    c.close(); add_activity(pid,"Team invitation accepted","%s added as %s"%(u["name"],role)); return jsonify(project_state(pid))

