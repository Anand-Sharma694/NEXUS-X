    if not s:return jsonify({"error":"Project not found."}),404
    return jsonify({"risks":s["risks"]})

@app.post("/api/what-if")
@auth_required
def what_if():
    d=request.get_json(silent=True) or {}; pid=int(d.get('project_id') or 0); s=project_state(pid) if pid else None
    if not s:return jsonify({'error':'Project not found.'}),404
    team=max(1,int(d.get('team',s['project']['team_size'])))
    deadline=max(1,int(d.get('deadline',s['project']['deadline_days'])))
    budget=float(d.get('budget',s['project']['budget']))
    scope=max(.5,min(2,float(d.get('scope_factor',1))))
    scaled=[{**t,'effort':float(t['effort'])*scope} for t in s['tasks']]
    cp=critical_path(scaled,s['dependencies'])
    capacity=team*deadline*.75
    effort=sum(float(t['effort']) for t in scaled)
    utilization=effort/max(1,capacity)*100
    scenario_project={**s['project'],'team_size':team,'deadline_days':deadline,'budget':budget}
    existing=s['team']
    avg_rate=statistics.mean([float(m.get('daily_rate') or os.getenv('NEXUS_DEFAULT_DAILY_RATE','2000')) for m in existing]) if existing else float(os.getenv('NEXUS_DEFAULT_DAILY_RATE','2000'))
    scenario_team=[]
    for i in range(team):
        base=existing[i] if i < len(existing) else {'name':f'Scenario Member {i+1}','role':'TEAM MEMBER','skills':'General','availability':80,'daily_rate':avg_rate}
        scenario_team.append({**base,'workload':min(100,round(utilization/max(1,team))), 'daily_rate':float(base.get('daily_rate') or avg_rate)})
    costs=project_cost_estimate(scenario_project,scaled,scenario_team)
    budget_feasible=(budget<=0 or costs['total']<=budget)
    risks=live_risk_engine(scenario_project,scaled,s['dependencies'],scenario_team,cp)
    if not budget_feasible:
        risks.append(_risk('Budget Overrun','HIGH' if costs['total']<=budget*1.25 else 'CRITICAL',9 if costs['total']>budget*1.5 else 8, f'Estimated project cost is â‚¹{costs["total"]:,.0f} against a â‚¹{budget:,.0f} scenario budget.',80,85,'Increase budget, reduce scope, or rebalance lower-cost capacity.'))
    health=health_engine(scenario_project,scaled,risks,scenario_team,cp)
    current=s['health']
    delta=health['health']-current
    feasible=not cp['has_cycle'] and cp['duration']<=deadline and capacity>=effort and budget_feasible
    verdict='NOT FEASIBLE' if not feasible else 'IMPROVES' if delta>3 else 'RISKIER' if delta<-3 else 'STABLE'
    result={'team':team,'deadline':deadline,'budget':budget,'scope_factor':scope,'capacity':round(capacity,1),'baseline_capacity':s['capacity'],'estimated_effort':round(effort,1),'risk_score':risks[0]['score'] if risks else 1,'risks':risks[:5],'deadline_feasible':feasible,'team_utilization':round(utilization),'health':health['health'],'current_health':current,'health_delta':delta,'verdict':verdict,'critical_path':cp['path'],'critical_path_duration':cp['duration'],'critical_path_slack':round(max(0,deadline-cp['duration']),2),'components':health['components'],'estimated_cost':costs['total'],'labor_cost':costs['labor'],'infrastructure_cost':costs['infrastructure'],'ai_cost':costs['ai'],'task_costs':costs.get('task_costs',[]),'budget_feasible':budget_feasible,'explanation':health['explanation'],'recommendation':('Increase budget or reduce scope.' if not budget_feasible else 'Add capacity or reduce scope.') if not feasible else ('This scenario materially improves project health.' if delta>3 else 'Protect the critical path and monitor the changed assumptions.')}
    c=db();c.execute('INSERT INTO scenarios(project_id,team_size,deadline_days,budget,scope_factor,result,created_at) VALUES(?,?,?,?,?,?,?)',(pid,team,deadline,budget,scope,json.dumps(result),now()));c.commit();c.close();add_activity(pid,'What-If scenario',f'Compared team {s["project"]["team_size"]}â†’{team}, deadline {s["project"]["deadline_days"]}â†’{deadline}, scope Ã—{scope}.');refresh_notifications(pid);return jsonify(result)

@app.get('/api/scenarios/<int:pid>')
@auth_required
def scenarios(pid):
    if not project_owned(pid): return jsonify({'error':'Project not found.'}),404
    c=db(); rows=[rowdict(x) for x in c.execute('SELECT * FROM scenarios WHERE project_id=? ORDER BY id DESC LIMIT 20',(pid,)).fetchall()];c.close()
    for r in rows:
        try:r['result']=json.loads(r['result'])
        except Exception:pass
    return jsonify({'scenarios':rows})

@app.get('/api/dependencies/<int:pid>/impact')
@auth_required
def dependency_impact(pid):
    s=project_state(pid)
    if not s:return jsonify({'error':'Project not found.'}),404
    by={t['task_key']:t for t in s['tasks']}
    impacts=[]
    for d in s['dependencies']:
        downstream=by.get(d['to_task']); upstream=by.get(d['from_task'])
        if not downstream or not upstream: continue
        impacts.append({'from':d['from_task'],'to':d['to_task'],'upstream_status':upstream['status'],'downstream_status':downstream['status'],'downstream_effort':downstream['effort'],'on_critical_path':d['from_task'] in s['critical_path'] or d['to_task'] in s['critical_path'],'impact':'HIGH' if d['to_task'] in s['critical_path'] else 'MEDIUM'})
    return jsonify({'impact':impacts,'cycle':s['dependency_cycle'],'critical_path':s['critical_path']})

def local_copilot(message, s=None):
    """
    Project-aware deterministic Copilot fallback.

    Important:
    - Different questions should produce different answers.
    - Intent detection is ordered from specific -> general.
    - This fallback remains useful even without OPENAI_API_KEY.
    """
    m = (message or "").strip().lower()


        # ---------------------------------------------------------
    # GENERAL CHAT / LEARNING INTENTS
    # ---------------------------------------------------------
    if m in {"hi", "hello", "hey", "hii", "helo", "good morning", "good afternoon", "good evening"}:
        return (
            "**Answer:** Hello! I'm **NEXUS-X Copilot**. "
            "I can help with projects, tasks, risks, schedules, teams, "
            "budgets, architecture, reports, technical questions and viva preparation."
        )

    if (
        "what can you do" in m
        or "what do you do" in m
        or m == "help"
        or "how can you help" in m
    ):
        return (
            "**Answer:** I can help you analyze your project, prioritize tasks, "
            "identify risks, check deadlines and critical paths, analyze team "
            "capacity, explain architecture and technology, run what-if scenarios, "
            "generate reports and prepare you for viva or interviews."
        )

    if "viva" in m or "interview" in m or "exam" in m:
        return (
            "**Answer:** I can help you prepare for your viva, exam or interview. "
            "I can explain the project, generate technical questions and answers, "
            "and quiz you one question at a time."
        )

    if "what is postgresql" in m or "what is postgres" in m or m in {"postgresql", "postgres"}:
        return (
            "**Answer:** PostgreSQL is an open-source relational database "
            "management system. It stores structured data in tables and supports "
            "SQL, relationships, transactions, indexes and advanced database features."
        )

    if "what is an api" in m or "what is api" in m or "what's an api" in m or m == "api":
        return (
            "**Answer:** An API, or Application Programming Interface, allows "
            "different software components to communicate with each other. "
            "For example, a frontend can call a backend API to retrieve or update data."
        )

    if "what is python" in m:
        return (
            "**Answer:** Python is a high-level programming language widely used "
            "for web development, automation, data analysis, AI and machine learning."
        )

    if "what is flask" in m:
        return (
            "**Answer:** Flask is a lightweight Python web framework used to build "
            "web applications and backend APIs."
        )

    if "what is sqlalchemy" in m:
        return (
            "**Answer:** SQLAlchemy is a Python database toolkit that provides "
            "SQL capabilities and database connectivity through Python."
        )

    if "what is csrf" in m:
        return (
            "**Answer:** CSRF stands for Cross-Site Request Forgery. It is a web "
            "security attack where an unwanted request is made using an authenticated "
            "user's session. CSRF tokens help prevent it."
        )

    if "what is authentication" in m:
        return (
            "**Answer:** Authentication verifies a user's identity. Authorization "
            "then determines what that authenticated user is allowed to access or change."
        )

    # ---------------------------------------------------------
    # PROJECT-SPECIFIC LEARNING INTENTS
    # ---------------------------------------------------------
    if s:
        if "architecture" in m or "system design" in m:
            return (
                f"**Answer:** The **architecture** of **{s.get('project_name', 'this project')}** "
                "describes how its major components communicate.\n\n"
                "**WHY:** Architecture separates responsibilities such as the user "
                "interface, backend/API, business logic, database and external services.\n\n"
                "**ACTION:** Review the data flow between these components and verify "
                "that authentication, authorization and database boundaries are clear."
            )

        if "viva" in m or "interview" in m or "exam" in m:
            return (
                f"**Answer:** Let's prepare you for your **viva** on "
                f"**{s.get('project_name', 'this project')}**.\n\n"
                "**Start with these questions:**\n"
                "1. What problem does this project solve?\n"
                "2. What are the main modules?\n"
                "3. Why did you choose the technology stack?\n"
                "4. How does the database work?\n"
                "5. How are authentication and authorization handled?\n"
                "6. What are the major risks?\n"
                "7. How would you test and deploy the system?\n\n"
                "**ACTION:** I can ask these one at a time and evaluate your answers."
            )

    if not s:
        if "nexus" in m:
            return (
                "**Answer:** NEXUS-X is a work-intelligence platform that turns "
                "project information into execution plans, risks and decisions.\n\n"
                "**ACTION:** Add a project for project-aware answers."
            )

        if any(k in m for k in ["python", "javascript", "code", "api", "sql"]):
            return (
                "**Answer:** I can help with coding questions.\n\n"
                "**ACTION:** Provide the relevant code, error or technical goal."
            )

        return (
            "**Answer:** I can answer general questions when the real AI model "
            "is configured.\n\n"
            "**ACTION:** Add OPENAI_API_KEY for full general-purpose Copilot capability."
        )

    # ---------------------------------------------------------
    # 1. FIRST / NEXT / PRIORITY TASK
    # Check this BEFORE "why" or "risk".
    # ---------------------------------------------------------
    first_question = any(k in m for k in [
        "which task",
        "what task",
        "first task",
        "start with",
        "work on first",
        "do first",
        "next task",
        "what should we do first",
        "what should the team work on",
        "priority task",
        "highest priority task",
        "most important task"
    ])

    if first_question:
        first = (
            next(
                (
                    t for t in s["tasks"]
                    if t["status"] != "COMPLETED"
                    and t["task_key"] in s["critical_path"]
                ),
                None,
            )
            or next(
                (
                    t for t in s["tasks"]
                    if t["status"] != "COMPLETED"
                ),
                None,
            )
        )

        if first:
            downstream = [
                d["to_task"]
                for d in s.get("dependencies", [])
                if d.get("from_task") == first["task_key"]
            ]

            dependency_text = (
                ", ".join(downstream)
                if downstream
                else "no immediate downstream tasks"
            )

            return (
                f"**Answer:** Start with **{first['task_key']} – {first['name']}**.\n\n"
                f"**WHY:** This is the highest-priority incomplete task on "
                f"the current critical path, so delaying it can affect downstream work.\n\n"
                f"**EVIDENCE:** Effort is **{first.get('effort', 0)} person-days**, "
                f"priority is **{first.get('priority', 'N/A')}**, "
                f"risk level is **{first.get('risk_level', 'N/A')}**, "
                f"and downstream dependencies include **{dependency_text}**.\n\n"
                f"**IMPACT:** A delay to this task can reduce the remaining "
                f"recovery time for the project because the current critical "
                f"path is **{s['critical_path_duration']} days** against a "
                f"**{s['project']['deadline_days']}-day deadline**.\n\n"
                f"**ACTION:** Protect this task from blockers, complete its "
                f"dependencies and update its status as soon as work progresses."
            )

    # ---------------------------------------------------------
    # 2. TEAM MEMBER / ASSIGNMENT
    # ---------------------------------------------------------
    assignment_question = any(k in m for k in [
        "who should",
        "who can",
        "best person",
        "best member",
        "assign",
        "team member",
        "who should handle",
        "who should work"
    ])

    if assignment_question:
        available = [
            member for member in s.get("team", [])
            if member.get("status", "ACTIVE") != "INACTIVE"
        ]

        if available:
            # Prefer the member with the lowest current workload.
            recommended = min(
                available,
                key=lambda x: float(x.get("workload", 0) or 0)
            )

            return (
                f"**Answer:** Consider **{recommended.get('name', 'the available team member')}** "
                f"for the next assignment.\n\n"
                f"**WHY:** The current project data shows this member has "
                f"the lowest available workload among the active team members.\n\n"
                f"**EVIDENCE:** Current workload is approximately "
                f"**{recommended.get('workload', 0)}%**.\n\n"
                f"**IMPACT:** Assigning work to a lower-utilization member can "
                f"reduce capacity pressure on the project.\n\n"
                f"**ACTION:** Review the member's skills and availability before "
                f"confirming the assignment."
            )

        return (
            "**Answer:** No active team member is currently available in the "
            "project data.\n\n"
            "**ACTION:** Add or activate a team member before assigning work."
        )

    # ---------------------------------------------------------
    # 3. DEADLINE / FEASIBILITY
    # ---------------------------------------------------------
    deadline_question = any(k in m for k in [
        "deadline",
        "feasible",
        "feasibility",
        "on time",
        "finish on time",
        "complete on time",
        "schedule realistic",
        "can we finish",
        "can the project finish"
    ])

    if deadline_question:
        status = s["health_status"]

        return (
            f"**Answer:** The project is currently **{status}** — health is "
            f"**{s['health']}%**.\n\n"
            f"**WHY:** The calculated critical path is **{s['critical_path_duration']} days** "
            f"while the deadline is **{s['project']['deadline_days']} days**.\n\n"
            f"**EVIDENCE:** Current progress is **{s['progress']}%**, "
            f"blocked tasks are **{s['blocked']}**, and the critical path is "
            f"**{' → '.join(s['critical_path']) or 'not available'}**.\n\n"
            f"**IMPACT:** If critical-path work slips, downstream tasks have "
            f"less recovery time before the deadline.\n\n"
            f"**ACTION:** Protect critical-path tasks and reduce scope, add "
            f"capacity, or extend the deadline if the schedule remains infeasible."
        )

    # ---------------------------------------------------------
    # 4. CRITICAL PATH
    # ---------------------------------------------------------
    if "critical path" in m or "critical-path" in m:
        return (
            f"**Answer:** The current critical path is "
            f"**{' → '.join(s['critical_path']) or 'not available'}**.\n\n"
            f"**WHY:** These tasks have the greatest scheduling influence "
            f"under the current dependency graph.\n\n"
            f"**EVIDENCE:** Calculated duration is "
            f"**{s['critical_path_duration']} days** versus a "
            f"**{s['project']['deadline_days']}-day deadline**.\n\n"
            f"**IMPACT:** Delay to a critical-path task can delay downstream work.\n\n"
            f"**ACTION:** Protect these tasks and resolve blockers immediately."
        )

    # ---------------------------------------------------------
    # 5. BLOCKERS
    # ---------------------------------------------------------
    if any(k in m for k in [
        "blocker",
        "blocked",
        "blocking",
        "what is blocking",
        "what's blocking"
    ]):
        blocked_tasks = [
            t for t in s["tasks"]
            if t.get("status") in ("BLOCKED", "BLOCKER")
        ]

        if blocked_tasks:
            names = ", ".join(
                f"{t['task_key']} – {t['name']}"
                for t in blocked_tasks[:8]
            )

            return (
                f"**Answer:** There are **{len(blocked_tasks)} blocked tasks**.\n\n"
                f"**WHY:** Blocked tasks can interrupt downstream execution.\n\n"
                f"**EVIDENCE:** {names}\n\n"
                f"**IMPACT:** Blocked work may increase schedule and dependency risk.\n\n"
                f"**ACTION:** Resolve the blocker with the highest critical-path impact first."
            )

        return (
            "**Answer:** There are currently **0 blocked tasks**.\n\n"
            "**WHY:** No task is currently marked as blocked in the project data.\n\n"
            "**ACTION:** Continue monitoring dependencies and critical-path tasks."
        )

    # ---------------------------------------------------------
    # 6. BUDGET / COST
    # ---------------------------------------------------------
    if any(k in m for k in [
        "budget",
        "cost",
        "expensive",
        "money",
        "financial"
    ]):
        budget = s["project"].get("budget", 0) or 0
        cost = s.get("cost_estimate", 0) or 0

        if budget:
            remaining = budget - cost
            feasibility = "within budget" if remaining >= 0 else "over budget"

            return (
                f"**Answer:** The current project is **{feasibility}**.\n\n"
                f"**WHY:** Estimated project cost is **₹{cost:,.0f}** "
                f"against a budget of **₹{budget:,.0f}**.\n\n"
                f"**EVIDENCE:** Remaining budget is approximately "
                f"**₹{remaining:,.0f}**.\n\n"
                f"**IMPACT:** Cost pressure can limit the ability to add capacity "
                f"or absorb schedule changes.\n\n"
                f"**ACTION:** Review high-cost tasks and infrastructure/API costs "
                f"before increasing project scope."
            )

        return (
            "**Answer:** No project budget is currently configured.\n\n"
            "**ACTION:** Set a project budget to enable budget-aware decisions."
        )

    # ---------------------------------------------------------
    # 7. RISK / WHY IS PROJECT AT RISK
    # ---------------------------------------------------------
    if any(k in m for k in [
        "risk",
        "risks",
        "at risk",
        "danger",
        "problem",
        "concern"
    ]):
        high = [
            r for r in s["risks"]
            if r["severity"] in ("HIGH", "CRITICAL")
        ]

        high_names = ", ".join(
            f"{r['name']} ({r['score']}/10)"
            for r in high
        ) or "none"

        return (
            f"**Answer:** The project is **{s['health_status']}** — health is "
            f"**{s['health']}%**.\n\n"
            f"**WHY:** { ' '.join(s['explanation']) }\n\n"
            f"**EVIDENCE:** High/critical risks: **{high_names}**; "
            f"critical path: **{s['critical_path_duration']} days**; "
            f"deadline: **{s['project']['deadline_days']} days**; "
            f"blocked tasks: **{s['blocked']}**.\n\n"
            f"**IMPACT:** High-risk work can reduce schedule recovery time "
            f"and increase project uncertainty.\n\n"
            f"**ACTION:** Address the highest-scoring risk and protect "
            f"critical-path work."
        )

    # ---------------------------------------------------------
    # 8. PROGRESS / HEALTH
    # ---------------------------------------------------------
    if any(k in m for k in [
        "health",
        "progress",
        "status",
        "how is the project"
    ]):
        return (
            f"**Answer:** Project health is **{s['health']}%** "
            f"({s['health_status']}).\n\n"
            f"**WHY:** Health is calculated from project progress, schedule, "
            f"risks, blockers, dependencies and workload.\n\n"
            f"**EVIDENCE:** Progress **{s['progress']}%**, "
            f"critical path **{s['critical_path_duration']} days**, "
            f"deadline **{s['project']['deadline_days']} days**, "
            f"blocked tasks **{s['blocked']}**.\n\n"
            f"**ACTION:** Focus on the highest-impact incomplete critical-path work."
        )

    # ---------------------------------------------------------
    # 9. GENERAL PROJECT QUESTION
    # ---------------------------------------------------------
    return (
        f"**Answer:** I understand this as a project question about "
        f"**{s['project'].get('name', 'the current project')}**.\n\n"
        f"**WHY:** The current project has **{len(s['tasks'])} tasks**, "
        f"**{len(s['risks'])} risks**, and **{len(s['dependencies'])} dependencies**.\n\n"
        f"**EVIDENCE:** Health is **{s['health']}%**, progress is "
        f"**{s['progress']}%**, and the critical path is "
        f"**{' → '.join(s['critical_path']) or 'not available'}**.\n\n"
        f"**ACTION:** Ask about the first task, critical path, deadline, "
        f"risks, blockers, budget, team assignment or project health."
    )


@app.post("/api/chat")
@rate_limit(30,60)
@auth_required
def chat():
    d=request.get_json(silent=True) or {};msg=(d.get("message") or "").strip();pid=int(d.get("project_id") or 0)
    if not msg:return jsonify({"error":"Message is required."}),400
    s=project_state(pid) if pid else None
    if pid and not s:return jsonify({"error":"Project not found."}),404
    context={"project":s["project"],"health":s["health"],"health_status":s["health_status"],"progress":s["progress"],"tasks":s["tasks"],"risks":s["risks"],"team":s["team"],"dependencies":s["dependencies"],"critical_path":s["critical_path"],"critical_path_duration":s["critical_path_duration"],"cost_estimate":s.get("cost_estimate"),"budget":s["project"].get("budget",0)} if s else None
    answer=None;mode="local"
    if os.getenv("OPENAI_API_KEY") and OpenAI:
        try:
            client=OpenAI(); prompt=f"""You are NEXUS-X Copilot. Answer the user's actual question directly. You can answer general questions, coding, business, learning and project questions. If project context is supplied, use it rather than inventing facts. For project decisions use WHY, EVIDENCE, IMPACT, ACTION when useful. Be concise and practical.\nPROJECT CONTEXT: {json.dumps(context,default=str)}\nUSER: {msg}"""
            r=client.responses.create(model=os.getenv("NEXUS_MODEL","gpt-5"),input=prompt);answer=r.output_text;mode="llm"
        except Exception as exc: app.logger.warning("LLM unavailable: %s",exc)
    if not answer: answer=local_copilot(msg,s)
    if s: add_activity(pid,"Copilot used",msg[:180])
    return jsonify({"answer":answer,"mode":mode,"project_id":pid or None})

@app.get("/api/notifications/<int:pid>")
@auth_required
def notifications(pid):
    if not project_owned(pid):return jsonify({"error":"Project not found."}),404
    refresh_notifications(pid); c=db(); rows=[rowdict(x) for x in c.execute("SELECT * FROM notifications WHERE project_id=? ORDER BY id DESC LIMIT 30",(pid,)).fetchall()]; unread=sum(1 for r in rows if not r["read"]); c.close(); return jsonify({"notifications":rows,"unread":unread})

@app.patch("/api/notifications/<int:nid>/read")
@auth_required
def mark_notification_read(nid):
    c=db(); n=c.execute("SELECT project_id FROM notifications WHERE id=?",(nid,)).fetchone(); c.close()
    if not n or not project_owned(n["project_id"]):return jsonify({"error":"Notification not found."}),404
    c=db(); c.execute("UPDATE notifications SET read=1 WHERE id=?",(nid,)); c.commit(); c.close(); return jsonify({"ok":True})

@app.post("/api/notifications/<int:pid>/read-all")
@auth_required
def mark_notifications_read(pid):
    if not project_owned(pid):return jsonify({"error":"Project not found."}),404
    c=db(); c.execute("UPDATE notifications SET read=1 WHERE project_id=?",(pid,)); c.commit(); c.close(); return jsonify({"ok":True})

@app.get("/api/activity/<int:pid>")
@auth_required
def activity(pid):
    if not project_owned(pid):return jsonify({"error":"Project not found."}),404
    c=db();rows=[rowdict(x) for x in c.execute("SELECT * FROM activity WHERE project_id=? ORDER BY id DESC LIMIT 30",(pid,)).fetchall()];c.close();return jsonify({"activity":rows})

@app.get("/api/analytics/<int:pid>")
@auth_required
def analytics(pid):
    if not project_owned(pid):return jsonify({"error":"Project not found."}),404
    s=project_state(pid); c=db(); rows=[rowdict(x) for x in c.execute("SELECT * FROM analytics_snapshots WHERE project_id=? ORDER BY id DESC LIMIT 60",(pid,)).fetchall()]; c.close()
    return jsonify({"snapshots":list(reversed(rows)),"current":{"health":s["health"],"progress":s["progress"],"risk_score":s["risk_average"],"workload":s["utilization"],"critical_path_days":s["critical_path_duration"]}})


@app.get("/api/export/tasks.csv/<int:pid>")
@auth_required
def export_csv(pid):
    s=project_state(pid)
    if not s:return jsonify({"error":"Project not found."}),404
    buf=io.StringIO();w=csv.writer(buf);w.writerow(["ID","Name","Priority","Effort","Risk","Status","Owner","Due"])
    for t in s["tasks"]:w.writerow([t["task_key"],t["name"],t["priority"],t["effort"],t["risk_level"],t["status"],t["owner"],t["due_date"] or ""])
    return send_file(io.BytesIO(buf.getvalue().encode()),as_attachment=True,download_name="nexus-tasks.csv",mimetype="text/csv")

@app.get("/api/export/report.pdf/<int:pid>")
@auth_required
def export_pdf(pid):
    s=project_state(pid)
    if not s:return jsonify({"error":"Project not found."}),404
    if canvas is None:return jsonify({"error":"PDF dependency unavailable."}),500
    buf=io.BytesIO();c=canvas.Canvas(buf,pagesize=A4);y=800;c.setFont("Helvetica-Bold",18);c.drawString(40,y,"NEXUS-X Project Report");y-=28;c.setFont("Helvetica",10)
    lines=[f"Project: {s['project']['name']}",f"Health: {s['health']}% ({s['health_status']}) | Progress: {s['progress']}%",f"Deadline: {s['project']['deadline_days']} days | Critical path: {s['critical_path_duration']} days",f"Critical path: {' -> '.join(s['critical_path'])}","","HEALTH WHY"]+s["explanation"]+["","TASKS"]+[f"{t['task_key']} {t['name']} â€” {t['status']} â€” {t['owner']}" for t in s["tasks"]]+["","RISKS"]+[f"{r['name']} â€” {r['severity']} {r['score']}/10 â€” {r['mitigation']}" for r in s["risks"]]
    for line in lines:
        if y<50:c.showPage();y=800;c.setFont("Helvetica",10)
        c.drawString(40,y,str(line)[:110]);y-=16
    c.save();buf.seek(0);return send_file(buf,as_attachment=True,download_name="nexus-project-report.pdf",mimetype="application/pdf")

@app.post("/api/generate-project.zip")
@rate_limit(20,60)
@auth_required
def generate_zip():
    """Generate a complete NEXUS-X execution baseline, spec-driven tests and documentation."""
    d = request.get_json(silent=True) or {}
    prompt = (d.get("prompt") or "").strip()
    pid = int(d.get("project_id") or 0)
    if pid:
        s = project_state(pid)
        if not s:
            return jsonify({"error": "Project not found."}), 404
        prompt = s["project"]["description"]
        a = {
            "project_name": s["project"]["name"],
            "objective": s["project"]["description"],
            "deadline_days": s["project"]["deadline_days"],
            "team_size": s["project"]["team_size"],
            "scope": [t["name"] for t in s["tasks"]],
            "requirements": [t["description"] for t in s["tasks"]],
            "tasks": s["tasks"],
            "dependencies": [[x["from_task"], x["to_task"]] for x in s["dependencies"]],
            "risks": s["risks"],
            "actions": s["explanation"],
        }
    else:
        if not prompt:
            return jsonify({"error": "Tell NEXUS-X what to build."}), 400
        a, _ = analyze_description(prompt)

    slug = re.sub(r"[^a-z0-9]+", "-", str(a.get("project_name") or "nexus-project").lower()).strip("-")[:40] or "nexus-project"
    features = list(dict.fromkeys(a.get("scope") or a.get("requirements") or []))
    task_rows = a.get("tasks") or []
    generated_at = now()
    task_json = json.dumps(task_rows, indent=2)
    dep_json = json.dumps(a.get("dependencies") or [], indent=2)
    risk_json = json.dumps(a.get("risks") or [], indent=2)

    files = {}
    files["README.md"] = f"""# {a.get('project_name', 'NEXUS Generated Project')}

Generated by NEXUS-X Project Builder 3.0 on {generated_at}.

## Original request
{prompt}

## Included
- Runnable Flask backend
- Browser frontend
- SQLite task persistence
- Health and task APIs
- Generated tests
- Architecture and implementation documentation
- Machine-readable PROJECT_SPEC.json

## Run
```powershell
python -m venv .venv
.\\.venv\\Scripts\\Activate.ps1
pip install -r requirements.txt
python -m pytest -q
python backend/app.py
```
Open http://127.0.0.1:5100

## Generated scope
{chr(10).join('- ' + str(x) for x in features) or '- Core application workflow'}

NEXUS-X generates a functional, editable full-stack execution baseline from the analyzed project specification. Provider credentials and deployment configuration remain environment-specific.
"""
    files["requirements.txt"] = "Flask>=3.1,<4\npytest>=8,<10\n"
    files[".env.example"] = "SECRET_KEY=change-me\nPORT=5100\n"
    files["PROJECT_SPEC.json"] = json.dumps({"generated_at": generated_at, "request": prompt, "project": a}, indent=2, default=str)
    files["docs/ARCHITECTURE.md"] = f"""# Architecture

Browser â†’ Flask API â†’ SQLite

## Features
{chr(10).join('- ' + str(x) for x in features) or '- Core workflow'}

## Dependencies
{dep_json}

## Risks
{risk_json}
"""
    plan = "\n".join(f"{i+1}. **{t.get('name','Task')}** â€” {t.get('description','')} â€” {t.get('effort',1)} person-days" for i, t in enumerate(task_rows))
    actions = "\n".join("- " + str(x) for x in (a.get("actions") or ["Implement the critical path first."]))
    files["docs/IMPLEMENTATION_PLAN.md"] = f"# Implementation Plan\n\n## Objective\n{a.get('objective', prompt)}\n\n## Tasks\n{plan}\n\n## Recommended next actions\n{actions}\n"
    files["backend/__init__.py"] = ""

    # Builder 2.0 ships the same full NEXUS-X runtime rather than a toy task scaffold.
    current_backend = Path(__file__).read_text(encoding="utf-8")
    current_index = (FRONTEND_DIR / "index.html").read_text(encoding="utf-8")
    current_js = (FRONTEND_DIR / "app.js").read_text(encoding="utf-8")
    current_css = (FRONTEND_DIR / "style.css").read_text(encoding="utf-8")
    files["backend/__init__.py"] = ""
    files["backend/app.py"] = current_backend
    files["frontend/index.html"] = current_index
    files["frontend/app.js"] = current_js
    files["frontend/style.css"] = current_css
    files["requirements.txt"] = "Flask>=3.1,<4\nFlask-Cors>=6.0,<7\npython-dotenv>=1.0,<2\nopenai>=1.0,<2\npytest>=8,<10\nreportlab>=4,<5\n"
    files[".env.example"] = "NEXUS_ENV=development\nNEXUS_SECRET_KEY=replace-with-a-random-32-character-secret\nNEXUS_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000\nNEXUS_DEFAULT_DAILY_RATE=2000\nNEXUS_ENABLE_DEMO=1\nOPENAI_API_KEY=\nNEXUS_MODEL=gpt-5\nNEXUS_SECURE_COOKIE=0\n"
    files["docs/BUILDER_2.md"] = f"""# NEXUS-X Builder 2.0

This generated project contains the complete NEXUS-X runtime, not a starter task-only scaffold.

## Included intelligence
- Authentication + RBAC + CSRF
- AI Analyzer 2.0 with local fallback
- OpenAI integration when configured
- Critical Path + dependency graph
- Health Engine
- Live Risk Engine
- What-If Simulator with budget/cost feasibility
- Team recommendation engine
- Notifications + activity history
- Analytics snapshots
- AI Copilot
- PDF/CSV reporting
- Responsive browser UI
- Project Builder

## Generated project specification
See `PROJECT_SPEC.json` for the exact request, scope, tasks, dependencies and risks used to configure this build.

## Run
```powershell
pip install -r requirements.txt
python -m pytest -q
python -m backend.app
```

The generated application is editable and intended as a complete execution baseline. Provider credentials and production deployment configuration remain environment-specific.
"""
    files["tests/test_app.py"] = """import json

import backend.app as mod


def test_home_and_health():
    c=mod.app.test_client()
    assert c.get('/') .status_code==200
    r=c.get('/api/health')
    assert r.status_code==200
    assert r.get_json()['status']=='online'


def test_analyzer_is_project_specific():
    a=mod._heuristic_analysis('Build an employee attendance dashboard with login, leave management, database and cloud deployment.')
    names=[t['name'] for t in a['tasks']]
    assert 'Attendance Management' in names
    assert 'Leave Management' in names
    assert 'Authentication' in names


def test_critical_path_is_calculated():
    tasks=[{'task_key':'T1','effort':2},{'task_key':'T2','effort':3},{'task_key':'T3','effort':1}]
    deps=[{'from_task':'T1','to_task':'T2'},{'from_task':'T2','to_task':'T3'}]
    cp=mod.critical_path(tasks,deps)
    assert cp['has_cycle'] is False
    assert cp['duration']==6
    assert cp['path']==['T1','T2','T3']


def test_cycle_is_detected():
    tasks=[{'task_key':'T1','effort':1},{'task_key':'T2','effort':1}]
    deps=[{'from_task':'T1','to_task':'T2'},{'from_task':'T2','to_task':'T1'}]
    assert mod.critical_path(tasks,deps)['has_cycle'] is True


def test_health_engine_changes_for_blocker():
    project={'deadline_days':10,'team_size':2}
    tasks=[{'task_key':'T1','effort':5,'status':'BLOCKED'},{'task_key':'T2','effort':5,'status':'NOT STARTED'}]
    cp=mod.critical_path(tasks,[{'from_task':'T1','to_task':'T2'}])
    risks=mod.live_risk_engine(project,tasks,[{'from_task':'T1','to_task':'T2'}],[],cp)
    h=mod.health_engine(project,tasks,risks,[],cp)
    assert h['blocked']==1
    assert h['health']<100


def test_cost_model_is_real():
    project={'infrastructure_cost':1000,'ai_cost':500}
    tasks=[{'effort':2,'owner':'Riya'},{'effort':1,'owner':'Alex'}]
    team=[{'name':'Riya','daily_rate':2400},{'name':'Alex','daily_rate':1800}]
    c=mod.project_cost_estimate(project,tasks,team)
    assert c['labor']==6600
    assert c['total']==8100


def test_project_spec_is_present():
    data=json.load(open('PROJECT_SPEC.json',encoding='utf-8'))
    assert data['request']
    assert data['project']['tasks']
    assert data['project']['dependencies'] is not None
    assert data['project']['risks'] is not None
"""
    files["tests/test_project_spec.py"] = """import json


def spec():
    return json.load(open("PROJECT_SPEC.json",encoding="utf-8"))["project"]


def test_spec_has_operational_model():
    p=spec()
    for key in ("project_name","objective","scope","requirements","tasks","dependencies","risks","actions"):
        assert key in p
    assert 1 <= len(p["tasks"]) <= 50


def test_task_keys_are_unique_and_estimates_are_positive():
    tasks=spec()["tasks"]
    keys=[t.get("task_key") for t in tasks]
    assert len(keys)==len(set(keys))
    assert all(float(t.get("effort",0))>0 for t in tasks)


def test_dependency_references_are_valid():
    p=spec(); keys={t.get("task_key") for t in p["tasks"]}
    for dep in p["dependencies"]:
        assert len(dep)==2 and dep[0] in keys and dep[1] in keys and dep[0]!=dep[1]


def test_risks_are_actionable():
    for risk in spec()["risks"]:
        assert risk.get("name") and risk.get("explanation") and risk.get("mitigation")
        assert 1 <= int(risk.get("score",1)) <= 10


def test_actions_and_scope_are_present():
    p=spec()
    assert p["scope"] and p["actions"]


def test_project_estimates_are_reasonable():
    p=spec()
    assert int(p.get("deadline_days",1)) >= 1
    assert int(p.get("team_size",1)) >= 1
"""
    mem = io.BytesIO()
    with zipfile.ZipFile(mem, "w", zipfile.ZIP_DEFLATED) as z:
        for n, v in files.items():
            z.writestr(n, v)
    mem.seek(0)
    if pid:
        add_activity(pid, "Project Builder", f"Generated runnable project scaffold with {len(files)} files.")
    return send_file(mem, as_attachment=True, download_name=f"{slug}.zip", mimetype="application/zip")

init_db()

if __name__=="__main__":
    app.run(host="0.0.0.0",port=int(os.getenv("PORT","5000")),debug=True)



