@app.post("/api/team/recommend")
@rate_limit(30,60)
@auth_required
def recommend_team_member():
    d=request.get_json(silent=True) or {}; pid=int(d.get("project_id") or 0); tid=int(d.get("task_id") or 0)
    if not project_owned(pid): return jsonify({"error":"Project not found."}),404
    c=db(); task=c.execute("SELECT * FROM tasks WHERE id=? AND project_id=?",(tid,pid)).fetchone(); members=[rowdict(x) for x in c.execute("SELECT * FROM team_members WHERE project_id=?",(pid,)).fetchall()]; c.close()
    if not task:return jsonify({"error":"Task not found."}),404
    if not members:return jsonify({"error":"Add team members before requesting a recommendation."}),400
    task_text=(str(task["name"])+" "+str(task["description"])).lower()
    keywords=set(re.findall(r"[a-z0-9+#.-]{2,}",task_text))
    ranked=[]
    for m in members:
        skill_text=(str(m.get("skills","")+" "+str(m.get("role",""))).lower())
        skill_words=set(re.findall(r"[a-z0-9+#.-]{2,}",skill_text))
        overlap=sorted(keywords & skill_words)
        skill_score=min(60,20+len(overlap)*10) if overlap else 15
        availability=max(0,min(100,float(m.get("availability") or 0)))
        workload=max(0,min(100,float(m.get("workload") or 0)))
        capacity_score=(100-workload)*0.25+availability*0.25
        score=int(max(0,min(100,round(skill_score+capacity_score))))
        effort=max(1,float(task["effort"] or 1))
        workload_after=round(min(100,workload+effort/max(1,availability)*20),1)
        reason=(f"Skill match: {', '.join(overlap[:6])}. " if overlap else "Limited direct skill overlap detected. ")+f"Availability is {availability:.0f}% and current workload is {workload:.0f}%."
        ranked.append({"member_id":m["id"],"id":m["id"],"name":m["name"],"role":m["role"],"match_score":score,"workload_after":workload_after,"reason":reason,"matched_skills":overlap})
    ranked.sort(key=lambda x:(x["match_score"],-x["workload_after"]),reverse=True)
    mode="skills-capacity evidence"
    if os.getenv("OPENAI_API_KEY") and OpenAI:
        try:
            client=OpenAI(); prompt=f"""You are NEXUS-X Team Planner. Rank candidates using only the supplied facts. Return ONLY JSON {{"ranked":[{{"id":1,"match_score":90,"reason":"..."}}]}}. Task: {json.dumps(rowdict(task),default=str)} Candidates: {json.dumps(ranked,default=str)}"""
            rr=client.responses.create(model=os.getenv("NEXUS_MODEL","gpt-5"),input=prompt); parsed=_parse_llm_json(rr.output_text)
            if parsed and isinstance(parsed.get("ranked"),list):
                by_id={x["id"]:x for x in ranked}; merged=[]
                for item in parsed["ranked"]:
                    base=by_id.get(int(item.get("id",0)))
                    if base:
                        base={**base,"match_score":int(max(0,min(100,int(item.get("match_score",base["match_score"]))))),"reason":str(item.get("reason") or base["reason"])[:500]}; merged.append(base)
                if merged:
                    ranked=merged+[x for x in ranked if x["id"] not in {m["id"] for m in merged}]; mode="llm+evidence"
        except Exception as exc: app.logger.warning("Team recommendation LLM unavailable: %s",exc)
    best=ranked[0]; add_activity(pid,"AI team recommendation",f"Recommended {best['name']} for {task['task_key']} with {best['match_score']}% match.")
    return jsonify({"task":rowdict(task),"recommended_member":best,"alternatives":ranked[1:5],"mode":mode,"explanation":"Recommendation uses task/skill overlap, availability and workload. When OpenAI is configured it can refine ranking using only these supplied facts."})


