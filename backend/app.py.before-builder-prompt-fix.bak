def now() -> str:
    return datetime.now(timezone.utc).isoformat()


@app.after_request
def security_headers(response):
    response.headers.setdefault("X-Content-Type-Options", "nosniff")
    response.headers.setdefault("X-Frame-Options", "DENY")
    response.headers.setdefault("Referrer-Policy", "strict-origin-when-cross-origin")
    response.headers.setdefault("Permissions-Policy", "camera=(), microphone=(), geolocation=()")
    response.headers.setdefault("Content-Security-Policy", "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'")
    if APP_ENV == "production":
        response.headers.setdefault("Strict-Transport-Security", "max-age=31536000; includeSubDomains")
    if request.path.startswith("/api/"):
        response.headers.setdefault("Cache-Control", "no-store")
    return response


_RATE_BUCKETS = {}

def _rate_limit_disabled():
    """Disable application rate limiting during automated pytest runs only."""
    return (
        app.testing
        or os.getenv("NEXUS_TESTING") == "1"
        or os.getenv("PYTEST_CURRENT_TEST") is not None
        or "pytest" in sys.modules
    )

def rate_limit(limit=60, window=60):
    def deco(fn):
        @wraps(fn)
        def wrapped(*args, **kwargs):
            # Automated tests must not be blocked by production abuse protection.
            # Rate limiting remains fully active during normal application execution.
            if _rate_limit_disabled():
                return fn(*args, **kwargs)

            key = (request.remote_addr or "unknown", request.endpoint or fn.__name__)
            now_m = time.monotonic()
            bucket = _RATE_BUCKETS.setdefault(key, [])
            bucket[:] = [t for t in bucket if now_m - t < window]

            if len(_RATE_BUCKETS) > 5000:
                stale_cutoff = now_m - max(window, 300)
                for k, vals in list(_RATE_BUCKETS.items()):
                    vals[:] = [t for t in vals if t >= stale_cutoff]
                    if not vals:
                        _RATE_BUCKETS.pop(k, None)

            if len(bucket) >= limit:
                return jsonify({
                    "error": "Too many requests. Please wait a moment and try again."
                }), 429

            bucket.append(now_m)
            return fn(*args, **kwargs)

        return wrapped
    return deco


class PGResult:
    """Small compatibility layer so the existing NEXUS-X SQL stays usable on PostgreSQL."""
    def __init__(self, cursor, lastrowid=None, buffered=None):
        self.cursor = cursor
        self.lastrowid = lastrowid
        self._buffered = list(buffered or [])

    def fetchone(self):
        if self._buffered:
            return self._buffered.pop(0)
        return self.cursor.fetchone()

    def fetchall(self):
        if self._buffered:
            rows = self._buffered[:]
            self._buffered.clear()
            return rows + self.cursor.fetchall()
        return self.cursor.fetchall()

    @property
    def rowcount(self):
        """Expose DB-API rowcount for compatibility with SQLite-style route code."""
        return self.cursor.rowcount

    def __iter__(self):
        if self._buffered:
            rows = self._buffered[:]
            self._buffered.clear()
            yield from rows
        yield from self.cursor


class PGConnection:
    def __init__(self, dsn):
        if psycopg is None:
            raise RuntimeError("PostgreSQL support requires psycopg[binary]. Install requirements.txt first.")
        dsn = dsn.replace("postgresql+psycopg://", "postgresql://", 1)
        self.conn = psycopg.connect(dsn, row_factory=dict_row)

    @staticmethod
    def _sql(sql):
        # Existing NEXUS-X queries use SQLite's qmark placeholders.
        return sql.replace("?", "%s")

    def execute(self, sql, params=()):
        q = self._sql(sql)
        stripped = q.lstrip().upper()
        is_insert = stripped.startswith("INSERT INTO") and "RETURNING" not in stripped
        if is_insert:
            q = q.rstrip().rstrip(";") + " RETURNING id"
        try:
            cur = self.conn.cursor()
            cur.execute(q, params)
            lastrowid = None
            buffered = []
            if is_insert:
                row = cur.fetchone()
                if row:
                    lastrowid = row.get("id") if isinstance(row, dict) else row[0]
            return PGResult(cur, lastrowid=lastrowid, buffered=buffered)
        except Exception as exc:
            # Keep existing route-level IntegrityError handling compatible.
            if exc.__class__.__name__ in {"UniqueViolation", "ForeignKeyViolation", "CheckViolation"}:
                raise sqlite3.IntegrityError(str(exc)) from exc
            raise

    def executescript(self, script):
        for statement in [x.strip() for x in script.split(";") if x.strip()]:
            self.execute(statement)
        return None

    def commit(self):
        self.conn.commit()

    def rollback(self):
        self.conn.rollback()

    def close(self):
        self.conn.close()


def _using_postgres():
    """
    Use PostgreSQL for normal application execution.
    Automated tests intentionally use their isolated temporary SQLite DB.
    This prevents tests from modifying the real development PostgreSQL database.
    """
    return USE_POSTGRES and not (
        app.testing
        or os.getenv("NEXUS_TESTING") == "1"
        or os.getenv("PYTEST_CURRENT_TEST") is not None
    )


def ensure_column(c, table, column, definition):
    if _using_postgres():
        exists = c.execute("SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name=? AND column_name=?", (table, column)).fetchone()
        if not exists:
            c.execute(f"ALTER TABLE {table} ADD COLUMN {column} {definition}")
    else:
        cols = {r[1] for r in c.execute(f"PRAGMA table_info({table})").fetchall()}
        if column not in cols:
            c.execute(f"ALTER TABLE {table} ADD COLUMN {column} {definition}")


def db():
    # Production/development -> PostgreSQL
    # pytest -> isolated temporary SQLite database
    if _using_postgres():
        return PGConnection(DATABASE_URL)

    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    c = sqlite3.connect(DB_PATH)
    c.row_factory = sqlite3.Row
    c.execute("PRAGMA foreign_keys=ON")
    return c


def rowdict(r):
    return dict(r) if r else None


def _postgres_schema(c):
    c.executescript("""
    CREATE TABLE IF NOT EXISTS users(id SERIAL PRIMARY KEY,name TEXT NOT NULL,email TEXT UNIQUE NOT NULL,password_hash TEXT NOT NULL,role TEXT NOT NULL DEFAULT 'TEAM MEMBER',plan TEXT NOT NULL DEFAULT 'FREE',created_at TEXT NOT NULL);
    CREATE TABLE IF NOT EXISTS projects(id SERIAL PRIMARY KEY,name TEXT NOT NULL,description TEXT NOT NULL,deadline_days INTEGER NOT NULL DEFAULT 14,team_size INTEGER NOT NULL DEFAULT 3,budget DOUBLE PRECISION NOT NULL DEFAULT 0,infrastructure_cost DOUBLE PRECISION NOT NULL DEFAULT 0,ai_cost DOUBLE PRECISION NOT NULL DEFAULT 0,created_at TEXT NOT NULL,owner_id INTEGER REFERENCES users(id));
    CREATE TABLE IF NOT EXISTS tasks(id SERIAL PRIMARY KEY,project_id INTEGER NOT NULL REFERENCES projects(id) ON DELETE CASCADE,task_key TEXT NOT NULL,name TEXT NOT NULL,description TEXT NOT NULL DEFAULT '',priority TEXT NOT NULL DEFAULT 'MEDIUM',effort DOUBLE PRECISION NOT NULL DEFAULT 1,risk_level TEXT NOT NULL DEFAULT 'MEDIUM',status TEXT NOT NULL DEFAULT 'NOT STARTED',owner TEXT NOT NULL DEFAULT 'Unassigned',due_date TEXT);
    CREATE TABLE IF NOT EXISTS dependencies(id SERIAL PRIMARY KEY,project_id INTEGER NOT NULL REFERENCES projects(id) ON DELETE CASCADE,from_task INTEGER NOT NULL REFERENCES tasks(id) ON DELETE CASCADE,to_task INTEGER NOT NULL REFERENCES tasks(id) ON DELETE CASCADE);
    CREATE TABLE IF NOT EXISTS risks(id SERIAL PRIMARY KEY,project_id INTEGER NOT NULL REFERENCES projects(id) ON DELETE CASCADE,name TEXT NOT NULL,severity TEXT NOT NULL,score INTEGER NOT NULL,explanation TEXT NOT NULL,probability INTEGER NOT NULL,impact INTEGER NOT NULL,mitigation TEXT NOT NULL,affected_tasks TEXT NOT NULL DEFAULT '');
    CREATE TABLE IF NOT EXISTS team_members(id SERIAL PRIMARY KEY,project_id INTEGER NOT NULL REFERENCES projects(id) ON DELETE CASCADE,name TEXT NOT NULL,role TEXT NOT NULL,skills TEXT NOT NULL,availability INTEGER NOT NULL DEFAULT 80,workload INTEGER NOT NULL DEFAULT 0,daily_rate DOUBLE PRECISION NOT NULL DEFAULT 0,user_id INTEGER REFERENCES users(id) ON DELETE SET NULL);
    CREATE TABLE IF NOT EXISTS project_members(id SERIAL PRIMARY KEY,project_id INTEGER NOT NULL REFERENCES projects(id) ON DELETE CASCADE,user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,role TEXT NOT NULL DEFAULT 'MEMBER',created_at TEXT NOT NULL,UNIQUE(project_id,user_id));
    CREATE TABLE IF NOT EXISTS analyses(id SERIAL PRIMARY KEY,project_id INTEGER NOT NULL REFERENCES projects(id) ON DELETE CASCADE,payload TEXT NOT NULL,created_at TEXT NOT NULL);
    CREATE TABLE IF NOT EXISTS scenarios(id SERIAL PRIMARY KEY,project_id INTEGER NOT NULL REFERENCES projects(id) ON DELETE CASCADE,team_size INTEGER NOT NULL,deadline_days INTEGER NOT NULL,budget DOUBLE PRECISION NOT NULL,scope_factor DOUBLE PRECISION NOT NULL,result TEXT NOT NULL,created_at TEXT NOT NULL);
    CREATE TABLE IF NOT EXISTS notifications(id SERIAL PRIMARY KEY,project_id INTEGER NOT NULL REFERENCES projects(id) ON DELETE CASCADE,type TEXT NOT NULL,title TEXT NOT NULL,message TEXT NOT NULL,read INTEGER NOT NULL DEFAULT 0,created_at TEXT NOT NULL);
    CREATE TABLE IF NOT EXISTS activity(id SERIAL PRIMARY KEY,project_id INTEGER NOT NULL REFERENCES projects(id) ON DELETE CASCADE,title TEXT NOT NULL,detail TEXT NOT NULL,created_at TEXT NOT NULL);
    CREATE TABLE IF NOT EXISTS analytics_snapshots(id SERIAL PRIMARY KEY,project_id INTEGER NOT NULL REFERENCES projects(id) ON DELETE CASCADE,health INTEGER NOT NULL,progress INTEGER NOT NULL,risk_score DOUBLE PRECISION NOT NULL,workload DOUBLE PRECISION NOT NULL,critical_path_days DOUBLE PRECISION NOT NULL,created_at TEXT NOT NULL);
    CREATE INDEX IF NOT EXISTS idx_projects_owner ON projects(owner_id);
    CREATE INDEX IF NOT EXISTS idx_tasks_project ON tasks(project_id);
    CREATE INDEX IF NOT EXISTS idx_dependencies_project ON dependencies(project_id);
    CREATE INDEX IF NOT EXISTS idx_risks_project ON risks(project_id);
    CREATE INDEX IF NOT EXISTS idx_team_project ON team_members(project_id);
    CREATE INDEX IF NOT EXISTS idx_activity_project_created ON activity(project_id,created_at);
    CREATE INDEX IF NOT EXISTS idx_snapshots_project_created ON analytics_snapshots(project_id,created_at);
    """)


def _run_postgres_migrations():
    if os.getenv("NEXUS_AUTO_MIGRATE", "1") != "1":
        return
    try:
        subprocess.run([sys.executable, "-m", "alembic", "upgrade", "head"], cwd=str(BASE_DIR), check=True, capture_output=True, text=True, timeout=60)
    except Exception as exc:
        app.logger.warning("Alembic auto-migration unavailable; applying safe bootstrap schema: %s", exc)


def init_db():
    c = db()

    # Never run PostgreSQL migrations against the test database.
    if _using_postgres():
        _run_postgres_migrations()
        _postgres_schema(c)
    else:
        c.executescript(
            """
            CREATE TABLE IF NOT EXISTS users(id INTEGER PRIMARY KEY AUTOINCREMENT,name TEXT NOT NULL,email TEXT UNIQUE NOT NULL,password_hash TEXT NOT NULL,role TEXT NOT NULL DEFAULT 'TEAM MEMBER',plan TEXT NOT NULL DEFAULT 'FREE',created_at TEXT NOT NULL);
            CREATE TABLE IF NOT EXISTS projects(id INTEGER PRIMARY KEY AUTOINCREMENT,name TEXT NOT NULL,description TEXT NOT NULL,deadline_days INTEGER NOT NULL DEFAULT 14,team_size INTEGER NOT NULL DEFAULT 3,budget REAL NOT NULL DEFAULT 0,infrastructure_cost REAL NOT NULL DEFAULT 0,ai_cost REAL NOT NULL DEFAULT 0,created_at TEXT NOT NULL,owner_id INTEGER,FOREIGN KEY(owner_id) REFERENCES users(id));
            CREATE TABLE IF NOT EXISTS tasks(id INTEGER PRIMARY KEY AUTOINCREMENT,project_id INTEGER NOT NULL,task_key TEXT NOT NULL,name TEXT NOT NULL,description TEXT NOT NULL DEFAULT '',priority TEXT NOT NULL DEFAULT 'MEDIUM',effort REAL NOT NULL DEFAULT 1,risk_level TEXT NOT NULL DEFAULT 'MEDIUM',status TEXT NOT NULL DEFAULT 'NOT STARTED',owner TEXT NOT NULL DEFAULT 'Unassigned',due_date TEXT,FOREIGN KEY(project_id) REFERENCES projects(id) ON DELETE CASCADE);
            CREATE TABLE IF NOT EXISTS dependencies(id INTEGER PRIMARY KEY AUTOINCREMENT,project_id INTEGER NOT NULL,from_task INTEGER NOT NULL,to_task INTEGER NOT NULL,FOREIGN KEY(project_id) REFERENCES projects(id) ON DELETE CASCADE,FOREIGN KEY(from_task) REFERENCES tasks(id) ON DELETE CASCADE,FOREIGN KEY(to_task) REFERENCES tasks(id) ON DELETE CASCADE);
            CREATE TABLE IF NOT EXISTS risks(id INTEGER PRIMARY KEY AUTOINCREMENT,project_id INTEGER NOT NULL,name TEXT NOT NULL,severity TEXT NOT NULL,score INTEGER NOT NULL,explanation TEXT NOT NULL,probability INTEGER NOT NULL,impact INTEGER NOT NULL,mitigation TEXT NOT NULL,affected_tasks TEXT NOT NULL DEFAULT '',FOREIGN KEY(project_id) REFERENCES projects(id) ON DELETE CASCADE);
            CREATE TABLE IF NOT EXISTS team_members(id INTEGER PRIMARY KEY AUTOINCREMENT,project_id INTEGER NOT NULL,name TEXT NOT NULL,role TEXT NOT NULL,skills TEXT NOT NULL,availability INTEGER NOT NULL DEFAULT 80,workload INTEGER NOT NULL DEFAULT 0,daily_rate REAL NOT NULL DEFAULT 0,user_id INTEGER,FOREIGN KEY(project_id) REFERENCES projects(id) ON DELETE CASCADE,FOREIGN KEY(user_id) REFERENCES users(id) ON DELETE SET NULL);
            CREATE TABLE IF NOT EXISTS project_members(id INTEGER PRIMARY KEY AUTOINCREMENT,project_id INTEGER NOT NULL,user_id INTEGER NOT NULL,role TEXT NOT NULL DEFAULT 'MEMBER',created_at TEXT NOT NULL,UNIQUE(project_id,user_id),FOREIGN KEY(project_id) REFERENCES projects(id) ON DELETE CASCADE,FOREIGN KEY(user_id) REFERENCES users(id) ON DELETE CASCADE);
            CREATE TABLE IF NOT EXISTS analyses(id INTEGER PRIMARY KEY AUTOINCREMENT,project_id INTEGER NOT NULL,payload TEXT NOT NULL,created_at TEXT NOT NULL,FOREIGN KEY(project_id) REFERENCES projects(id) ON DELETE CASCADE);
            CREATE TABLE IF NOT EXISTS scenarios(id INTEGER PRIMARY KEY AUTOINCREMENT,project_id INTEGER NOT NULL,team_size INTEGER NOT NULL,deadline_days INTEGER NOT NULL,budget REAL NOT NULL,scope_factor REAL NOT NULL,result TEXT NOT NULL,created_at TEXT NOT NULL,FOREIGN KEY(project_id) REFERENCES projects(id) ON DELETE CASCADE);
            CREATE TABLE IF NOT EXISTS notifications(id INTEGER PRIMARY KEY AUTOINCREMENT,project_id INTEGER NOT NULL,type TEXT NOT NULL,title TEXT NOT NULL,message TEXT NOT NULL,read INTEGER NOT NULL DEFAULT 0,created_at TEXT NOT NULL,FOREIGN KEY(project_id) REFERENCES projects(id) ON DELETE CASCADE);
            CREATE TABLE IF NOT EXISTS activity(id INTEGER PRIMARY KEY AUTOINCREMENT,project_id INTEGER NOT NULL,title TEXT NOT NULL,detail TEXT NOT NULL,created_at TEXT NOT NULL,FOREIGN KEY(project_id) REFERENCES projects(id) ON DELETE CASCADE);
            CREATE TABLE IF NOT EXISTS analytics_snapshots(id INTEGER PRIMARY KEY AUTOINCREMENT,project_id INTEGER NOT NULL,health INTEGER NOT NULL,progress INTEGER NOT NULL,risk_score REAL NOT NULL,workload REAL NOT NULL,critical_path_days REAL NOT NULL,created_at TEXT NOT NULL,FOREIGN KEY(project_id) REFERENCES projects(id) ON DELETE CASCADE);
            """
        )
        ensure_column(c, "projects", "infrastructure_cost", "REAL NOT NULL DEFAULT 0")
        ensure_column(c, "projects", "ai_cost", "REAL NOT NULL DEFAULT 0")
        ensure_column(c, "team_members", "daily_rate", "REAL NOT NULL DEFAULT 0")
    if not USE_POSTGRES:
        c.execute("UPDATE team_members SET daily_rate=? WHERE daily_rate<=0", (float(os.getenv("NEXUS_DEFAULT_DAILY_RATE", "2000")),))
    else:
        c.execute("UPDATE team_members SET daily_rate=? WHERE daily_rate<=0", (float(os.getenv("NEXUS_DEFAULT_DAILY_RATE", "2000")),))
    if not c.execute("SELECT 1 FROM users WHERE email=?", (DEMO_EMAIL,)).fetchone() and APP_ENV != "production" and os.getenv("NEXUS_ENABLE_DEMO", "1") == "1":
        c.execute("INSERT INTO users(name,email,password_hash,role,plan,created_at) VALUES(?,?,?,?,?,?)", (DEMO_NAME, DEMO_EMAIL, generate_password_hash(DEMO_PASSWORD), "ADMIN", "FREE", now()))
    c.commit(); c.close()

def current_user():
    uid = session.get("uid")
    if not uid:
        return None
    c = db()
    r = c.execute("SELECT * FROM users WHERE id=?", (uid,)).fetchone()
    c.close()
    return rowdict(r)


def auth_required(fn):
    @wraps(fn)
    def wrapper(*args, **kwargs):
        if not current_user():
            return jsonify({"error": "Please log in first."}), 401
        if request.method in {"POST", "PATCH", "PUT", "DELETE"}:
            token = request.headers.get("X-CSRF-Token")
            if not token or token != session.get("csrf"):
                return jsonify({"error": "CSRF validation failed. Refresh the workspace and try again."}), 403
        return fn(*args, **kwargs)
    return wrapper


def project_owned(pid: int):
    """Return a project the current user is authorized to access.
    The historical helper name is retained for compatibility with earlier routes.
    """
    u=current_user()
    if not u:return None
    c=db()
    if u["role"]=="ADMIN":
        p=c.execute("SELECT * FROM projects WHERE id=?",(pid,)).fetchone()
    else:
        p=c.execute("SELECT p.* FROM projects p LEFT JOIN project_members pm ON pm.project_id=p.id AND pm.user_id=? WHERE p.id=? AND (p.owner_id=? OR pm.user_id IS NOT NULL)",(u["id"],pid,u["id"])).fetchone()
    c.close(); return rowdict(p)


def can_manage_project(pid: int, user=None) -> bool:
    user = user or current_user()
    if not user:
        return False
    p = project_owned(pid)
    if p and (p["owner_id"] == user["id"] or user["role"] == "ADMIN"):
        return True
    c = db(); r = c.execute("SELECT 1 FROM project_members WHERE project_id=? AND user_id=? AND role IN ('OWNER','ADMIN','MANAGER')", (pid, user["id"])).fetchone(); c.close()
    return bool(r)

def require_manager(pid: int):
    u=current_user()
    if not u: return jsonify({"error":"Please log in first."}),401
    if not can_manage_project(pid,u): return jsonify({"error":"Manager or owner permission required."}),403
    return None

def parse_num(text, patterns, default):
    for p in patterns:
        m = re.search(p, text, re.I)
        if m:
            try:
                return max(1, int(m.group(1)))
            except (TypeError, ValueError):
                pass
    return default


def _risk(name, severity, score, explanation, probability, impact, mitigation, affected=()):
    return {"name": name, "severity": severity, "score": int(max(1, min(10, score))), "explanation": explanation,
            "probability": int(probability), "impact": int(impact), "mitigation": mitigation, "affected_tasks": list(affected)}


def _heuristic_analysis(description: str) -> dict[str, Any]:
    t = description.strip()
    l = t.lower()

    deadline = parse_num(t, [r'(\d+)\s*days?', r'deadline\s*[:=]?\s*(\d+)'], 14)
    team = parse_num(t, [r'team\s*(?:of|size)?\s*(\d+)', r'(\d+)\s*(?:developers|people|members|engineers)'], 3)

    feature_rules = [
        (['attendance', 'time tracking', 'check-in', 'check out'], 'Attendance Management', 'Implement employee attendance, check-in/check-out rules and attendance records.', 5.0, 'HIGH', 'Backend'),
        (['leave', 'leave management', 'vacation'], 'Leave Management', 'Implement leave requests, approvals, balances and leave history.', 5.0, 'HIGH', 'Backend'),
        (['productivity'], 'Productivity Tracking', 'Track productivity indicators and generate productivity summaries.', 5.0, 'HIGH', 'Backend'),
        (['dashboard', 'manager dashboard', 'admin dashboard'], 'Dashboard', 'Build role-specific dashboards with important operational metrics.', 4.0, 'HIGH', 'Frontend'),
        (['notification', 'notifications', 'alerts'], 'Notifications', 'Implement notifications, delivery state and read/unread handling.', 3.0, 'MEDIUM', 'Backend'),
        (['report', 'reports', 'reporting', 'analytics'], 'Reporting & Analytics', 'Generate reports and analytics from project data.', 4.0, 'HIGH', 'Backend'),
        (['login', 'authentication', 'sign in', 'signin'], 'Authentication', 'Implement secure login, sessions and authentication flows.', 3.0, 'CRITICAL', 'Security'),
        (['role-based', 'role based', 'roles', 'authorization', 'permissions', 'permission', 'rbac'], 'Role-Based Access', 'Implement roles, permissions and authorization checks.', 3.0, 'CRITICAL', 'Security'),
        (['database', 'data storage', 'sql', 'postgres', 'mysql', 'sqlite'], 'Database & Data Model', 'Design the database schema and persistence layer.', 4.0, 'HIGH', 'Backend'),
        (['api', 'rest api', 'integration', 'external service'], 'API & Integrations', 'Implement API contracts and external service integrations.', 4.0, 'HIGH', 'Integrations'),
        (['security', 'secure', 'security testing'], 'Security', 'Validate authorization, input handling, secrets and security controls.', 3.0, 'CRITICAL', 'Security'),
        (['cloud', 'cloud deployment', 'deployment', 'deploy', 'aws', 'azure', 'gcp'], 'Cloud Deployment', 'Prepare staging, configuration, deployment and rollback procedures.', 4.0, 'HIGH', 'DevOps'),
        (['mobile', 'android', 'ios'], 'Mobile Experience', 'Implement the required mobile user experience.', 4.0, 'HIGH', 'Frontend'),
        (['iot', 'sensor', 'device'], 'IoT Integration', 'Connect devices or sensors and process operational data.', 5.0, 'HIGH', 'Integrations'),
        (['payment', 'payments', 'billing', 'subscription'], 'Payments', 'Implement secure payment and transaction workflows.', 5.0, 'CRITICAL', 'Backend'),
    ]

    detected = []
    for keywords, name, desc, effort, risk, owner in feature_rules:
        if any(k in l for k in keywords):
            detected.append({'name': name, 'description': desc, 'effort': effort, 'risk': risk, 'owner': owner})
    unique = {}
    for feature in detected:
        unique[feature['name']] = feature
    detected = list(unique.values())

    tasks = []
    def add_task(name, desc, effort, risk, owner):
        tasks.append({'task_key': f'T{len(tasks)+1}', 'name': name, 'description': desc,
                      'priority': 'CRITICAL' if risk == 'CRITICAL' else ('HIGH' if risk == 'HIGH' else 'MEDIUM'),
                      'effort': float(effort), 'risk_level': risk, 'status': 'NOT STARTED', 'owner': owner})

    add_task('Requirements', 'Define scope, acceptance criteria, constraints and success criteria.', 2.0, 'HIGH', 'Product Lead')
    add_task('Architecture', 'Design application structure, data flow, APIs and technical boundaries.', 3.0, 'HIGH', 'Architect')
    for feature in detected:
        add_task(feature['name'], feature['description'], feature['effort'], feature['risk'], feature['owner'])
    if not detected:
        add_task('Core Implementation', 'Implement the primary workflow described by the project.', 6.0, 'HIGH', 'Backend')

    add_task('Testing', 'Validate happy paths, failure paths, security and regressions.', 5.0 if deadline <= 7 else 4.0,
             'CRITICAL' if deadline <= 7 else 'HIGH', 'QA')
    add_task('Deployment', 'Prepare staging, release, rollback and production deployment procedures.', 3.0,
             'HIGH' if deadline <= 10 else 'MEDIUM', 'DevOps')
    add_task('Monitoring', 'Track application health, errors, failures and operational signals.', 2.0, 'MEDIUM', 'Operations')

    deps = []
    if len(tasks) >= 2:
        deps.append(('T1', 'T2'))
    for i in range(3, len(tasks)+1):
        if tasks[i-1]['name'] not in ['Testing', 'Deployment', 'Monitoring']:
            deps.append(('T2', f'T{i}'))
    testing_key = next((x['task_key'] for x in tasks if x['name'] == 'Testing'), None)
    deployment_key = next((x['task_key'] for x in tasks if x['name'] == 'Deployment'), None)
    monitoring_key = next((x['task_key'] for x in tasks if x['name'] == 'Monitoring'), None)
    if testing_key:
        for task in tasks:
            if task['task_key'] not in ['T1', testing_key] and task['name'] not in ['Deployment', 'Monitoring', 'Testing']:
                deps.append((task['task_key'], testing_key))
    if testing_key and deployment_key: deps.append((testing_key, deployment_key))
    if deployment_key and monitoring_key: deps.append((deployment_key, monitoring_key))
    deps = list(dict.fromkeys(deps))

    risks = []
    if any(x in l for x in ['login','authentication','auth','role','permission','security']):
        risks.append(_risk('Security','HIGH',8,'Authentication, authorization and security controls can affect downstream release paths.',70,85,
                           'Define roles, validation, authorization and secret handling before release.', []))
    if any(x in l for x in ['employee','attendance','leave']):
        risks.append(_risk('Data Accuracy','HIGH',7,'Incorrect employee, attendance or leave data can make operational reports unreliable.',65,80,
                           'Define validation rules, audit important changes and test edge cases.', []))
    if any(x in l for x in ['cloud','deployment','deploy']):
        risks.append(_risk('Cloud Deployment','MEDIUM',6,'Limited deployment experience can create configuration and release problems.',60,70,
                           'Use staging and perform a deployment rehearsal before production.', []))
    if any(x in l for x in ['notification','notifications']):
        risks.append(_risk('Notification Delivery','MEDIUM',5,'Notification failures can cause users to miss important workflow events.',50,65,
                           'Test delivery failures, retries and notification state handling.', []))
    if any(x in l for x in ['payment','payments','billing']):
        risks.append(_risk('Payment','CRITICAL',9,'Payment flows require correctness, security and failure-path testing.',80,90,
                           'Use sandbox transactions, idempotency and explicit success/failure testing.', []))
    if any(x in l for x in ['requirements may change','requirements can change','requirements change']):
        risks.append(_risk('Scope Change','HIGH',7,'Changing requirements can create rework and disrupt the critical path.',70,75,
                           'Freeze must-have scope and use controlled change approval.', []))
    if deadline <= 10:
        risks.append(_risk('Schedule','HIGH',8 if deadline <= 7 else 7,'The delivery window leaves limited recovery time if critical work slips.',75,85,
                           'Protect the critical path and freeze non-essential scope.', []))
    if team < 3:
        risks.append(_risk('Resource Shortage','HIGH',8,'A small team can become a bottleneck when multiple critical tasks need attention.',70,80,
                           'Reduce scope or add capacity to critical-path work.', []))
    risks.append(_risk('Testing','HIGH' if deadline <= 10 else 'MEDIUM',7 if deadline <= 10 else 5,
                       'Late testing increases rework and compresses the release recovery window.',60,75,
                       'Start testing before implementation is completely finished.', []))

    scope = [x['name'] for x in detected] or ['Core Application']
    actions = [
        'Freeze must-have scope before implementation.',
        'Protect the calculated critical path and parallelize independent work.',
        'Test failure paths early instead of waiting for final QA.'
    ]
    if any(x in l for x in ['cloud','deployment']):
        actions.append('Run a staging deployment before final QA.')
    if any(x in l for x in ['requirements may change','requirements can change','requirements change']):
        actions.append('Use controlled scope changes so requirement changes do not destabilize the release plan.')
    if any(x in l for x in ['attendance','leave','employee']):
        actions.append('Validate employee, attendance and leave data rules before building reports.')
    actions.append('Review the project after every material scope, dependency or deadline change.')

    project_name = 'NEXUS-X Project'
    if 'attendance' in l and 'employee' in l: project_name = 'Employee Attendance & Productivity Platform'
    elif 'attendance' in l: project_name = 'Attendance Management Platform'
    elif 'payment' in l: project_name = 'Payment Platform'
    elif 'iot' in l: project_name = 'IoT Monitoring Platform'
    elif 'dashboard' in l: project_name = 'Business Dashboard Platform'

    return {'project_name': project_name, 'objective': t[:180], 'deadline_days': deadline, 'team_size': team,
            'scope': scope, 'requirements': scope, 'tasks': tasks, 'dependencies': deps, 'risks': risks, 'actions': actions}

def _parse_llm_json(text: str):
    text = text.strip()
    if text.startswith("```"):
        text = re.sub(r"^```(?:json)?\s*|\s*```$", "", text, flags=re.I | re.S)
    try:
        return json.loads(text)
    except Exception:
        m = re.search(r"\{.*\}", text, re.S)
        if m:
            try:
                return json.loads(m.group(0))
            except Exception:
                return None
    return None


def analyze_description(description: str) -> tuple[dict[str, Any], str]:
    fallback = _heuristic_analysis(description)
    if not (os.getenv("OPENAI_API_KEY") and OpenAI):
        return fallback, "heuristic"
    schema = {"project_name": "string", "objective": "string", "deadline_days": 14, "team_size": 3,
              "scope": ["string"], "requirements": ["string"], "tasks": [{"task_key": "T1", "name": "string", "description": "string", "priority": "HIGH", "effort": 2, "risk_level": "MEDIUM", "status": "NOT STARTED", "owner": "string"}],
              "dependencies": [["T1", "T2"]], "risks": [{"name": "string", "severity": "HIGH", "score": 7, "explanation": "string", "probability": 70, "impact": 80, "mitigation": "string", "affected_tasks": ["T1"]}],
              "actions": ["string"]}
    prompt = f"""You are NEXUS-X Analyzer. Convert this messy project/work description into a practical execution model. Return ONLY valid JSON matching this schema. Do not invent precise facts that are not inferable; use reasonable estimates for effort (person-days) and clearly explain risks. Create 5-12 concrete tasks, dependency pairs, and 3-8 risks.\nSCHEMA: {json.dumps(schema)}\nDESCRIPTION: {description}"""
    try:
        client = OpenAI()
        resp = client.responses.create(model=os.getenv("NEXUS_MODEL", "gpt-5"), input=prompt)
        parsed = _parse_llm_json(resp.output_text)
        if parsed and isinstance(parsed.get("tasks"), list) and isinstance(parsed.get("risks"), list):
            # Fill missing operational fields from the deterministic engine so downstream calculations stay safe.
            parsed.setdefault("deadline_days", fallback["deadline_days"])
            parsed.setdefault("team_size", fallback["team_size"])
            parsed.setdefault("project_name", fallback["project_name"])
            parsed.setdefault("objective", description[:180])
            parsed.setdefault("actions", fallback["actions"])
            return parsed, "llm"
    except Exception as exc:
        app.logger.warning("Analyzer LLM unavailable: %s", exc)
    return fallback, "heuristic"


def build_graph(tasks, deps):
    by_key = {t["task_key"]: t for t in tasks}
    graph = {k: [] for k in by_key}
    incoming = {k: [] for k in by_key}
    for d in deps:
        a, b = d["from_task"], d["to_task"]
        if a in by_key and b in by_key and a != b:
            graph[a].append(b); incoming[b].append(a)
    return by_key, graph, incoming


def critical_path(tasks, deps):
    by_key, graph, incoming = build_graph(tasks, deps)
    indegree = {k: len(v) for k, v in incoming.items()}
    queue = [k for k, v in indegree.items() if v == 0]
    order = []
    while queue:
        k = queue.pop(0); order.append(k)
        for nxt in graph[k]:
            indegree[nxt] -= 1
            if indegree[nxt] == 0: queue.append(nxt)
    if len(order) != len(by_key):
        return {"has_cycle": True, "path": [], "duration": 0.0, "slack": {}, "earliest": {}, "latest": {}}

    es = {k: 0.0 for k in by_key}; ef = {}
    for k in order:
        es[k] = max((ef[p] for p in incoming[k]), default=0.0)
        ef[k] = es[k] + float(by_key[k].get("effort", 1) or 1)
    duration = max(ef.values(), default=0.0)
    lf = {k: duration for k in by_key}; ls = {}
    for k in reversed(order):
        lf[k] = min((ls[n] for n in graph[k]), default=duration)
        ls[k] = lf[k] - float(by_key[k].get("effort", 1) or 1)
    slack = {k: round(max(0.0, ls[k] - es[k]), 2) for k in by_key}
    path = [k for k in order if slack[k] <= 0.01]
    return {"has_cycle": False, "path": path, "duration": round(duration, 2), "slack": slack,
            "earliest": {k: round(es[k], 2) for k in es}, "latest": {k: round(ls[k], 2) for k in ls}}


def live_risk_engine(project, tasks, deps, team, cp):
    """Recalculate risk from current project state instead of trusting stale scores."""
    risks=[]
    total=max(1.0,sum(float(t.get('effort') or 0) for t in tasks))
    blocked=sum(float(t.get('effort') or 0) for t in tasks if t.get('status')=='BLOCKED')
    unfinished=sum(float(t.get('effort') or 0) for t in tasks if t.get('status')!='COMPLETED')
    deadline=max(1,float(project.get('deadline_days') or 1))
    schedule_ratio=(cp.get('duration',0)/deadline) if not cp.get('has_cycle') else 2
    avg_workload=(sum(float(m.get('workload') or 0) for m in team)/len(team)) if team else 0
    capacity=max(1,float(project.get('team_size') or 1)*deadline*.75)
    utilization=unfinished/capacity*100

    def add(name, score, probability, impact, severity, why, mitigation, affected=()):
        score=int(max(1,min(10,round(score))))
        sev='CRITICAL' if score>=9 else 'HIGH' if score>=7 else 'MEDIUM' if score>=4 else 'LOW'
        risks.append(_risk(name, sev, score, why, int(max(1,min(100,round(probability)))), int(max(1,min(100,round(impact)))), mitigation, affected))

    if cp.get('has_cycle'):
        add('Dependency Cycle',10,95,95,'CRITICAL','A dependency cycle prevents reliable scheduling and can block downstream work.','Remove or reverse the dependency that closes the cycle.')
    elif schedule_ratio>1:
        add('Schedule',8+min(2,round((schedule_ratio-1)*4)),78,90,'HIGH',f'Critical-path effort is {cp["duration"]} days against a {deadline:g}-day deadline.','Reduce scope, add capacity, or move the deadline.',cp.get('path',[]))
    elif schedule_ratio>.8:
        add('Schedule',6,62,75,'MEDIUM','The critical path is consuming most of the available deadline.','Protect critical-path work and review scope before adding new work.',cp.get('path',[]))

    if blocked:
        add('Blocked Work',7+min(2,round(blocked/total*4)),70,85,'HIGH',f'{blocked:.1f} effort is currently blocked, creating downstream delay pressure.','Resolve the blocking dependency and re-check the critical path.')
    if avg_workload>90 or utilization>100:
        add('Capacity',8,75,80,'HIGH',f'Team workload/capacity is under pressure ({avg_workload:.0f}% recorded workload, {utilization:.0f}% estimated utilization).','Rebalance ownership, reduce scope, or add capacity.')
    elif avg_workload>80 or utilization>85:
        add('Capacity',6,55,65,'MEDIUM','Team capacity is becoming constrained.','Rebalance work before critical-path tasks are affected.')

    high_degree={}
    for d in deps:
        high_degree[d['to_task']]=high_degree.get(d['to_task'],0)+1
    overloaded=[k for k,v in high_degree.items() if v>=3]
    if overloaded:
        add('Dependency Pressure',7,65,72,'HIGH',f'{len(overloaded)} task(s) have three or more upstream dependencies.','Sequence high-dependency tasks early and remove unnecessary coupling.',overloaded)

    # Preserve domain-specific risks, but rescore them using current pressure.
    text=' '.join(str(t.get('name',''))+' '+str(t.get('description','')) for t in tasks).lower()
    if 'payment' in text or 'transaction' in text:
        add('Payment',7 + (1 if schedule_ratio>0.8 else 0) + (1 if blocked else 0),65,90,'HIGH','Payment work is a high-impact release path and is sensitive to schedule, security and failure-path testing.','Use sandbox transactions, idempotency, reconciliation and explicit failure-path tests.',[t['task_key'] for t in tasks if 'integr' in t.get('name','').lower() or 'test' in t.get('name','').lower()])
    if 'security' in text or 'auth' in text or 'login' in text:
        add('Security',7 + (1 if schedule_ratio>0.9 else 0),55,88,'HIGH','Authentication and security controls can affect every downstream release path.','Validate authorization, input handling, secrets and security tests before release.')

    # Deduplicate by name, keeping the highest score.
    unique={}
    for r in risks:
        if r['name'] not in unique or r['score']>unique[r['name']]['score']: unique[r['name']]=r
    if not unique:
        add('Scope',4,40,55,'MEDIUM','No dominant technical risk is currently detected, but scope can still create rework.','Keep acceptance criteria explicit and review changes before adding work.')
    return sorted(unique.values(),key=lambda r:r['score'],reverse=True)


def health_engine(project, tasks, risks, team, cp):
    total_effort = sum(float(t.get('effort') or 0) for t in tasks) or 1
    completed_effort = sum(float(t.get('effort') or 0) for t in tasks if t.get('status') == 'COMPLETED')
    progress = round(completed_effort / total_effort * 100)
    blocked_effort = sum(float(t.get('effort') or 0) for t in tasks if t.get('status') == 'BLOCKED')
    avg_risk = sum(int(r['score']) for r in risks) / max(1, len(risks))
    deadline=max(1,float(project.get('deadline_days') or 1))
    schedule_ratio=cp.get('duration',0)/deadline if not cp.get('has_cycle') else 2
    schedule_score=max(0,min(100,round(100 - max(0,schedule_ratio-.65)*180)))
    risk_score=max(0,min(100,round(100-avg_risk*6-len([r for r in risks if r['score']>=7])*4)))
    blocker_score=max(0,min(100,round(100-blocked_effort/total_effort*100)))
    cp_score=20 if cp.get('has_cycle') else max(0,min(100,round(100-max(0,cp.get('duration',0)-deadline)*14)))
    recorded_workload=(sum(float(m.get('workload') or 0) for m in team)/len(team)) if team else 0
    capacity=max(1,float(project.get('team_size') or 1)*deadline*.75)
    utilization=(total_effort-completed_effort)/capacity*100
    workload_pressure=max(recorded_workload,utilization)
    workload_score=max(0,min(100,round(100-max(0,workload_pressure-70)*2)))
    dependency_pressure=min(100,sum(1 for _ in []))
    dependency_pressure=max(0,min(100,round((len(cp.get('path',[]))/max(1,len(tasks)))*100)))
    dependency_score=max(0,100-round(dependency_pressure*.25))
    components={'progress':progress,'schedule':schedule_score,'risk':risk_score,'blockers':blocker_score,'critical_path':cp_score,'workload':workload_score,'dependencies':dependency_score}
    health=round(progress*.28+schedule_score*.20+risk_score*.18+blocker_score*.10+cp_score*.12+workload_score*.07+dependency_score*.05)
    health=max(0,min(100,health))
    status='HEALTHY' if health>=80 else 'NEEDS ATTENTION' if health>=60 else 'AT RISK'
    reasons=[]
    if cp.get('has_cycle'): reasons.append('A dependency cycle prevents reliable scheduling.')
    elif cp.get('duration',0)>deadline: reasons.append(f'Critical path is {cp["duration"]} days versus a {deadline:g}-day deadline.')
    if risks:
            top_name = risks[0].get("name") or "Top identified risk"
            reasons.append(f'Top risk is {top_name} at {risks[0].get("score", 0)}/10.')
    if blocked_effort: reasons.append(f'{blocked_effort:.1f} effort is blocked.')
    if workload_pressure>85: reasons.append(f'Capacity pressure is {workload_pressure:.0f}%.')
    if not reasons: reasons.append('No dominant constraint is currently detected.')
    return {'health':health,'health_status':status,'progress':progress,'total_effort':round(total_effort,1),'completed_effort':round(completed_effort,1),'capacity':round(capacity,1),'blocked':sum(t.get('status')=='BLOCKED' for t in tasks),'high_risks':len([r for r in risks if r['score']>=7]),'risk_average':round(avg_risk,1),'utilization':round(utilization),'components':components,'explanation':reasons}

def record_snapshot(pid, s):
    try:
        c=db()
        latest=c.execute("SELECT health,progress,risk_score,workload,critical_path_days FROM analytics_snapshots WHERE project_id=? ORDER BY id DESC LIMIT 1", (pid,)).fetchone()
        vals=(int(s.get("health",0)),int(s.get("progress",0)),float(s.get("risk_average",0) or 0),float(s.get("utilization",0) or 0),float(s.get("critical_path_duration",0) or 0))
        should_write=latest is None or any(abs(float(vals[i])-float(latest[i]))>0.01 for i in range(5))
        if should_write:
            c.execute("INSERT INTO analytics_snapshots(project_id,health,progress,risk_score,workload,critical_path_days,created_at) VALUES(?,?,?,?,?,?,?)", (pid,*vals,now()))
            c.execute("DELETE FROM analytics_snapshots WHERE project_id=? AND id NOT IN (SELECT id FROM analytics_snapshots WHERE project_id=? ORDER BY id DESC LIMIT 120)", (pid,pid))
            c.commit()
        c.close()
    except Exception:
        pass


def project_cost_estimate(project, tasks, team, extra_infra=0.0, extra_ai=0.0):
    default_rate=float(os.getenv("NEXUS_DEFAULT_DAILY_RATE", "2000"))
    rates={str(m.get("name")):float(m.get("daily_rate") or default_rate) for m in team}
    avg=statistics.mean(rates.values()) if rates else default_rate
    labor=sum(float(t.get("effort") or 0)*rates.get(str(t.get("owner") or ""),avg) for t in tasks)
    infrastructure=float(project.get("infrastructure_cost") or 0)+float(extra_infra or 0)
    ai=float(project.get("ai_cost") or 0)+float(extra_ai or 0)
    task_costs=[]
    for t in tasks:
        rate=rates.get(str(t.get("owner") or ""),avg)
        cost=float(t.get("effort") or 0)*rate
        task_costs.append({"task_key":t.get("task_key"),"name":t.get("name"),"effort":round(float(t.get("effort") or 0),2),"daily_rate":round(rate,2),"labor_cost":round(cost,2)})
    total=labor+infrastructure+ai
    return {"labor":round(labor,2),"infrastructure":round(infrastructure,2),"ai":round(ai,2),"total":round(total,2),"daily_rate":round(avg,2),"task_costs":task_costs}


def project_state(pid):
    p = project_owned(pid)
    if not p:
        return None
    c = db()
    tasks = [rowdict(x) for x in c.execute("SELECT * FROM tasks WHERE project_id=? ORDER BY id", (pid,)).fetchall()]
    deps = [rowdict(x) for x in c.execute("SELECT d.id,a.task_key from_task,b.task_key to_task FROM dependencies d JOIN tasks a ON a.id=d.from_task JOIN tasks b ON b.id=d.to_task WHERE d.project_id=?", (pid,)).fetchall()]
    stored_risks = [rowdict(x) for x in c.execute("SELECT * FROM risks WHERE project_id=? ORDER BY score DESC", (pid,)).fetchall()]
    team = [rowdict(x) for x in c.execute("SELECT * FROM team_members WHERE project_id=?", (pid,)).fetchall()]
    c.close()
    cp = critical_path(tasks, deps)
    risks = live_risk_engine(p, tasks, deps, team, cp)
    h = health_engine(p, tasks, risks, team, cp)
    path_details = []
    for key in cp["path"]:
        t = next((x for x in tasks if x["task_key"] == key), None)
        if t:
            path_details.append({"task_key": key, "name": t["name"], "effort": t["effort"], "slack": cp["slack"].get(key, 0)})
    state={"project": p, "tasks": tasks, "dependencies": deps, "risks": risks, "team": team, **h,
            "critical_path": cp["path"], "critical_path_details": path_details, "critical_path_duration": cp["duration"],
            "critical_path_slack": max(0, round(p["deadline_days"] - cp["duration"], 2)), "dependency_cycle": cp["has_cycle"]}
    state["cost_estimate"] = project_cost_estimate(p,tasks,team)
    record_snapshot(pid,state)
    return state


def add_activity(pid, title, detail):
    c = db(); c.execute("INSERT INTO activity(project_id,title,detail,created_at) VALUES(?,?,?,?)", (pid, title, detail, now())); c.commit(); c.close()


def refresh_notifications(pid):
    s = project_state(pid)
    if not s: return
    c = db()
    # Keep one active notification per semantic event instead of recreating duplicates on every refresh.
    desired = []
    if s["health"] < 60:
        desired.append(("HEALTH", "Project health is at risk", f"Health is {s['health']}%: " + " ".join(s["explanation"])))
    for r in s["risks"]:
        if r["severity"] in ("HIGH", "CRITICAL"):
            desired.append(("RISK", f"{r['name']} risk", r["mitigation"]))
    for t in s["tasks"]:
        if t["status"] == "BLOCKED": desired.append(("BLOCKER", f"{t['name']} is blocked", "Resolve its dependency before downstream work."))
    existing = {(r["type"], r["title"]): r for r in c.execute("SELECT * FROM notifications WHERE project_id=?", (pid,)).fetchall()}
    for typ, title, message in desired:
        if (typ, title) not in existing:
            c.execute("INSERT INTO notifications(project_id,type,title,message,created_at) VALUES(?,?,?,?,?)", (pid, typ, title, message, now()))
    active_keys = {(x[0], x[1]) for x in desired}
    for key, row in existing.items():
        if key not in active_keys and not row["read"]:
            c.execute("DELETE FROM notifications WHERE id=?", (row["id"],))
    c.commit(); c.close()


def seed_project(name, description, owner_id):
    a, mode = analyze_description(description)
    # Run deterministic calculations on whatever the analyzer produced.
    c = db()
    cur = c.execute("INSERT INTO projects(name,description,deadline_days,team_size,owner_id,created_at) VALUES(?,?,?,?,?,?)", (name, description, int(a.get("deadline_days",14)), int(a.get("team_size",3)), owner_id, now()))
    pid = cur.lastrowid
    ids = {}
    for x in a["tasks"]:
        ids[x["task_key"]] = c.execute("INSERT INTO tasks(project_id,task_key,name,description,priority,effort,risk_level,status,owner) VALUES(?,?,?,?,?,?,?,?,?)", (pid, x["task_key"], x["name"], x.get("description", ""), x.get("priority", "MEDIUM"), float(x.get("effort", 1)), x.get("risk_level", "MEDIUM"), x.get("status", "NOT STARTED"), x.get("owner", "Unassigned"))).lastrowid
    for fr, to in a.get("dependencies", []):
        if fr in ids and to in ids and fr != to: c.execute("INSERT INTO dependencies(project_id,from_task,to_task) VALUES(?,?,?)", (pid, ids[fr], ids[to]))
    for r in a.get("risks", []):
        c.execute("INSERT INTO risks(project_id,name,severity,score,explanation,probability,impact,mitigation,affected_tasks) VALUES(?,?,?,?,?,?,?,?,?)", (pid, r["name"], r["severity"], int(r["score"]), r["explanation"], int(r.get("probability",60)), int(r.get("impact",70)), r["mitigation"], ",".join(r.get("affected_tasks", []))))
    members = [("Alex", "Frontend", "UI, React, CSS", 85, 25, 1800), ("Riya", "Backend", "Python, APIs, SQL", 90, 35, 2400), ("Dev", "QA / Security", "Testing, security, automation", 70, 20, 2200)]
    for m in members[:max(1, min(3, int(a.get("team_size",3))))]: c.execute("INSERT INTO team_members(project_id,name,role,skills,availability,workload,daily_rate) VALUES(?,?,?,?,?,?,?)", (pid, *m))
    c.execute("INSERT INTO analyses(project_id,payload,created_at) VALUES(?,?,?)", (pid, json.dumps({**a, "analysis_mode": mode}), now()))
    c.execute("INSERT INTO project_members(project_id,user_id,role,created_at) VALUES(?,?,?,?) ON CONFLICT (project_id,user_id) DO NOTHING", (pid,owner_id,"OWNER",now()))
    c.commit(); c.close()
    add_activity(pid, "Project created", f"{mode.upper()} analysis generated {len(a['tasks'])} tasks, {len(a.get('dependencies',[]))} dependencies and {len(a.get('risks',[]))} risks.")
    refresh_notifications(pid)
    return pid


# ---------------- Routes ----------------
@app.get("/")
def home(): return send_from_directory(FRONTEND_DIR, "index.html")

@app.get("/<path:path>")
def static_files(path): return send_from_directory(FRONTEND_DIR, path)

@app.post("/api/signup")
@rate_limit(12,60)
def signup():
    d=request.get_json(silent=True) or {}
    name=(d.get("name") or "").strip()[:80]
    email=(d.get("email") or "").strip().lower()
    password=d.get("password") or ""
    if len(name)<2 or not re.match(r"^[^@\s]+@[^@\s]+\.[^@\s]+$",email): return jsonify({"error":"Enter a valid name and email."}),400
    if len(password)<8: return jsonify({"error":"Password must be at least 8 characters."}),400
    c=db()
    try:
        uid=c.execute("INSERT INTO users(name,email,password_hash,role,plan,created_at) VALUES(?,?,?,?,?,?)",(name,email,generate_password_hash(password),"TEAM MEMBER","FREE",now())).lastrowid
        c.commit()
    except sqlite3.IntegrityError:
        c.close(); return jsonify({"error":"An account with that email already exists."}),409
    c.close(); session["uid"]=uid; session["csrf"]=os.urandom(16).hex()
    return jsonify({"ok":True,"user":{"id":uid,"name":name,"email":email,"role":"TEAM MEMBER","plan":"FREE"},"csrf":session["csrf"]})

@app.post("/api/login")
@rate_limit(12,60)
def login():
    d = request.get_json(silent=True) or {}; email = (d.get("email") or DEMO_EMAIL).strip().lower(); password = d.get("password") or DEMO_PASSWORD
    c = db(); u = c.execute("SELECT * FROM users WHERE email=?", (email,)).fetchone()
    if not u or not check_password_hash(u["password_hash"], password): c.close(); return jsonify({"error": "Invalid email or password. Demo: demo@nexus-x.local / demo123"}), 401
    session["uid"] = u["id"]; session["csrf"] = os.urandom(16).hex(); c.close()
    return jsonify({"ok": True, "user": {k: u[k] for k in ["id","name","email","role","plan"]}, "csrf": session["csrf"]})

@app.post("/api/logout")
def logout():
    """
    Logout is intentionally idempotent and does not require CSRF.

    Logging out only destroys the current session. It does not create,
    modify, or expose privileged application state, so requiring a CSRF
    token here adds friction without meaningful security benefit.
    """
    session.clear()
    return jsonify({"ok": True})

@app.get("/api/me")
def me():
    u = current_user(); return jsonify({"user": ({k:u[k] for k in ["id","name","email","role","plan"]} if u else None),"csrf":session.get("csrf") if u else None})

@app.patch("/api/me")
@auth_required
def update_me():
    d=request.get_json(silent=True) or {}; u=current_user(); name=(d.get("name") or u["name"]).strip()[:80]
    if len(name)<2:return jsonify({"error":"Name is too short."}),400
    c=db(); c.execute("UPDATE users SET name=? WHERE id=?",(name,u["id"])); c.commit(); c.close(); return jsonify({"user":{**{k:u[k] for k in ["id","email","role","plan"]},"name":name}})

@app.post("/api/me/password")
@auth_required
def change_password():
    d=request.get_json(silent=True) or {}; old=d.get("old_password") or ""; new=d.get("new_password") or ""; u=current_user()
    if not check_password_hash(u["password_hash"],old):return jsonify({"error":"Current password is incorrect."}),400
    if len(new)<8:return jsonify({"error":"New password must be at least 8 characters."}),400
    c=db(); c.execute("UPDATE users SET password_hash=? WHERE id=?",(generate_password_hash(new),u["id"])); c.commit(); c.close(); return jsonify({"ok":True})

@app.get("/api/health")
def health(): return jsonify({"name":"NEXUS-X","status":"online","ai":"llm" if os.getenv("OPENAI_API_KEY") and OpenAI else "local-fallback","phase":"5-verification","features":["analyzer-2","critical-path","health-engine","risk-engine","what-if","team-recommendation","analytics-snapshots","builder-2","csrf","rate-limit"]})

@app.post("/api/analyze")
@rate_limit(30,60)
def analyze():
    d = request.get_json(silent=True) or {}; desc = (d.get("description") or "").strip()
    if not desc: return jsonify({"error":"Please describe the problem or project."}), 400
    a, mode = analyze_description(desc)
    # Compute deterministic critical path/health for analysis preview.
    pseudo_project = {"deadline_days": int(a.get("deadline_days",14)), "team_size": int(a.get("team_size",3))}
    pseudo_tasks = [{"task_key":x["task_key"],"name":x["name"],"effort":float(x.get("effort",1)),"status":x.get("status","NOT STARTED"),"owner":x.get("owner","Unassigned")} for x in a["tasks"]]
    pseudo_deps = [{"from_task":x[0],"to_task":x[1]} for x in a.get("dependencies",[])]
    cp = critical_path(pseudo_tasks,pseudo_deps); h = health_engine(pseudo_project,pseudo_tasks,a.get("risks",[]),[],cp)
    a.update({"analysis_mode":mode,"critical_path":cp["path"],"critical_path_details":[{"task_key":k,"name":next(t["name"] for t in pseudo_tasks if t["task_key"]==k),"effort":next(t["effort"] for t in pseudo_tasks if t["task_key"]==k),"slack":cp["slack"].get(k,0)} for k in cp["path"]],"critical_path_duration":cp["duration"],"dependency_cycle":cp["has_cycle"],**h})
    return jsonify({"analysis":a})

