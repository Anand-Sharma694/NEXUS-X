@app.post("/api/dependencies")
@auth_required
def add_dependency():
    d=request.get_json(silent=True) or {};pid=int(d.get("project_id") or 0);p=project_owned(pid)
    if not p:return jsonify({"error":"Project not found."}),404
    err=require_manager(pid)
    if err:return err
    c=db(); a=c.execute("SELECT id,task_key FROM tasks WHERE id=? AND project_id=?",(d.get("from_task_id"),pid)).fetchone(); b=c.execute("SELECT id,task_key FROM tasks WHERE id=? AND project_id=?",(d.get("to_task_id"),pid)).fetchone()
    if not a or not b or a["id"]==b["id"]:c.close();return jsonify({"error":"Invalid dependency."}),400
    existing=[rowdict(x) for x in c.execute("SELECT d.from_task,d.to_task,a.task_key from_key,b.task_key to_key FROM dependencies d JOIN tasks a ON a.id=d.from_task JOIN tasks b ON b.id=d.to_task WHERE d.project_id=?",(pid,)).fetchall()]
    test=[*existing,{"from_task":a["id"],"to_task":b["id"],"from_key":a["task_key"],"to_key":b["task_key"]}]
    # Convert to keys and run cycle check.
    tasks=[rowdict(x) for x in c.execute("SELECT * FROM tasks WHERE project_id=?",(pid,)).fetchall()]; deps=[{"from_task":x["from_key"],"to_task":x["to_key"]} for x in test]
    if critical_path(tasks,deps)["has_cycle"]:c.close();return jsonify({"error":"Dependency would create a cycle."}),400
    c.execute("INSERT INTO dependencies(project_id,from_task,to_task) VALUES(?,?,?)",(pid,a["id"],b["id"]));c.commit();c.close();add_activity(pid,"Dependency added",f"{a['task_key']} â†’ {b['task_key']}");return jsonify(project_state(pid))

@app.delete("/api/dependencies/<int:did>")
@auth_required
def delete_dependency(did):
    c=db();r=c.execute("SELECT project_id,from_task,to_task FROM dependencies WHERE id=?",(did,)).fetchone()
    if not r or not project_owned(r["project_id"]):c.close();return jsonify({"error":"Dependency not found."}),404
    c.close(); err=require_manager(r["project_id"])
    if err:return err
    c=db(); c.execute("DELETE FROM dependencies WHERE id=?",(did,));c.commit();c.close();add_activity(r["project_id"],"Dependency removed",f"Dependency #{did} removed");return jsonify(project_state(r["project_id"]))

