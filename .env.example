# NEXUS-X environment
NEXUS_ENV=development
NEXUS_SECRET_KEY=replace-with-a-random-32-character-secret
NEXUS_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
NEXUS_DEFAULT_DAILY_RATE=2000
NEXUS_ENABLE_DEMO=1
NEXUS_SECURE_COOKIE=0
OPENAI_API_KEY=
NEXUS_MODEL=gpt-5

# Product database. Leave empty to use local SQLite; set this for PostgreSQL.
DATABASE_URL=postgresql+psycopg://nexus:nexus_password@localhost:5432/nexus_x
NEXUS_AUTO_MIGRATE=1
