from pathlib import Path

ROOT = Path(".")
EXTENSIONS = {".html", ".js", ".css", ".py", ".json", ".md"}

# Common UTF-8 mojibake -> correct Unicode
FIXES = {
    "â€”": "—",
    "â€“": "–",
    "â†’": "→",
    "â†": "←",
    "â†‘": "↑",
    "â†“": "↓",
    "âœ“": "✓",
    "âœ”": "✔",
    "âœ—": "✗",
    "âœ˜": "✘",
    "âœ…": "✅",
    "âš ": "⚠",
    "âš ": "⚠",
    "âš™": "⚙",
    "â‚¹": "₹",
    "Ã—": "×",
    "Ã·": "÷",
    "Ã©": "é",
    "Ã¨": "è",
    "Ã¡": "á",
    "Ã³": "ó",
    "Ã±": "ñ",
    "Ã¼": "ü",
    "Ã¶": "ö",
    "Ã¤": "ä",
    "â€œ": "“",
    "â€": "”",
    "â€˜": "‘",
    "â€™": "’",
    "â€¦": "…",
    "Â·": "·",
    "Â": "",
}

changed = []

for path in ROOT.rglob("*"):
    if not path.is_file():
        continue

    if path.suffix.lower() not in EXTENSIONS:
        continue

    # Never modify caches, git, or generated Python cache
    if any(part in {"__pycache__", ".git", ".pytest_cache", "node_modules"} for part in path.parts):
        continue

    try:
        text = path.read_text(encoding="utf-8")
    except Exception:
        continue

    original = text

    for bad, good in FIXES.items():
        text = text.replace(bad, good)

    if text != original:
        backup = path.with_name(path.name + ".encoding-backup")
        if not backup.exists():
            backup.write_text(original, encoding="utf-8")

        path.write_text(text, encoding="utf-8")
        changed.append(str(path))

print()
print("=" * 60)
print(" NEXUS-X UTF-8 REPAIR")
print("=" * 60)

if changed:
    print("Fixed files:")
    for item in changed:
        print("  OK:", item)
else:
    print("No common mojibake was found.")

print()
print("Backups were created as *.encoding-backup")
